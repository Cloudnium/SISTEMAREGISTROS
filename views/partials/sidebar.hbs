<!-- ══════════════════════════════════════════
     PARTIAL: sidebar.hbs
     ► LOGO: reemplaza .sidebar-logo-text con:
       <img src="/images/logos/logo.png" class="sidebar-logo-img" />
     ► ÍCONOS: cambia data-lucide="nombre"
       ver todos en https://lucide.dev/icons/
══════════════════════════════════════════ -->
<aside class="sidebar" id="sidebar">

  <!-- Barra superior: logo + botón para contraer/expandir (solo escritorio) -->
  <div class="sidebar-brand">
    <div class="sidebar-brand-logo">
      <span class="sidebar-brand-logo-name">Cloudnium</span>
      <span class="sidebar-brand-logo-tagline">Tu logística, en buenas manos</span>
    </div>
    <button class="sidebar-toggle-btn" id="sidebarToggleBtn" onclick="toggleSidebarCollapse()" title="Contraer menú" aria-label="Contraer o expandir menú">
      <i data-lucide="panel-left-close" id="sidebarToggleIcon"></i>
    </button>
  </div>

  <!-- Usuario en sesión -->
  <div class="sidebar-user">
    <div class="sidebar-user-avatar">
      {{#if user.avatar}}
        <img src="{{user.avatar}}" alt="Avatar" />
      {{else}}
        <span>{{user.nombre.[0]}}</span>
      {{/if}}
    </div>
    <div class="sidebar-user-info">
      <span class="sidebar-user-name">{{user.nombre}}</span>
      <span class="sidebar-user-role">{{user.rol}}</span>
    </div>
  </div>

  <!-- Navegación -->
  <nav class="sidebar-nav">

    <a href="/dashboard" class="sidebar-nav-item {{#if (eq currentPath '/dashboard')}}active{{/if}}" title="Dashboard">
      <i data-lucide="layout-dashboard"></i><span>Dashboard</span>
    </a>

    {{#if mostrarGrupoBoletaje}}
    <div class="sidebar-group" data-group="boletaje">
      <button type="button" class="sidebar-group-header" data-group-toggle="boletaje" aria-expanded="true">
        <span class="sidebar-group-header-label"><i data-lucide="ticket"></i><span>Boletaje</span></span>
        <i data-lucide="chevron-down" class="sidebar-group-chevron"></i>
      </button>
      <div class="sidebar-group-items" id="sidebarGroup-boletaje">
        <div class="sidebar-flyout-titulo">Boletaje</div>

        {{#if (or isDesarrollador secciones.boletaje)}}
        <a href="/boletaje" class="sidebar-nav-item {{#if (eq currentPath '/boletaje')}}active{{/if}}" title="Boletaje">
          <i data-lucide="ticket"></i><span>Boletaje</span>
        </a>
        {{/if}}

        {{#if (or isDesarrollador secciones.[consulta-documentos])}}
        <a href="/consulta-documentos" class="sidebar-nav-item {{#if (eq currentPath '/consulta-documentos')}}active{{/if}}" title="Consulta de Documentos">
          <i data-lucide="file-search"></i><span>Consulta de Documentos</span>
        </a>
        {{/if}}

        {{#if (or isDesarrollador secciones.servicios)}}
        <a href="/servicios" class="sidebar-nav-item {{#if (eq currentPath '/servicios')}}active{{/if}}" title="Servicios">
          <i data-lucide="layout-grid"></i><span>Servicios</span>
        </a>
        {{/if}}

        {{#if (or isDesarrollador secciones.buses)}}
        <a href="/buses" class="sidebar-nav-item {{#if (eq currentPath '/buses')}}active{{/if}}" title="Buses">
          <i data-lucide="bus"></i><span>Buses</span>
        </a>
        {{/if}}

        {{#if (or isDesarrollador secciones.ciudades)}}
        <a href="/ciudades" class="sidebar-nav-item {{#if (eq currentPath '/ciudades')}}active{{/if}}" title="Ciudades / Agencias">
          <i data-lucide="map-pin"></i><span>Ciudades / Agencias</span>
        </a>
        {{/if}}

        {{#if (or isDesarrollador secciones.destinos)}}
        <a href="/destinos" class="sidebar-nav-item {{#if (eq currentPath '/destinos')}}active{{/if}}" title="Destinos">
          <i data-lucide="route"></i><span>Destinos</span>
        </a>
        {{/if}}

      </div>
    </div>
    {{/if}}

    {{#if mostrarGrupoGeneral}}
    <div class="sidebar-group" data-group="general">
      <button type="button" class="sidebar-group-header" data-group-toggle="general" aria-expanded="true">
        <span class="sidebar-group-header-label"><i data-lucide="layers"></i><span>General</span></span>
        <i data-lucide="chevron-down" class="sidebar-group-chevron"></i>
      </button>
      <div class="sidebar-group-items" id="sidebarGroup-general">
        <div class="sidebar-flyout-titulo">General</div>

        {{#if puedeVerCombustible}}
        {{#if (or isDesarrollador secciones.combustible)}}
        <a href="/combustible" class="sidebar-nav-item {{#if (eq currentPath '/combustible')}}active{{/if}}" title="Combustible">
          <i data-lucide="fuel"></i><span>Combustible</span>
        </a>
        {{/if}}
        {{/if}}

        {{#if puedeVerPersonal}}
        {{#if (or isDesarrollador secciones.personal)}}
        <a href="/personal" class="sidebar-nav-item {{#if (eq currentPath '/personal')}}active{{/if}}" title="Personal">
          <i data-lucide="users"></i><span>Personal</span>
        </a>
        {{/if}}
        {{/if}}

        {{#if puedeVerInventario}}
        {{#if (or isDesarrollador secciones.inventario)}}
        <a href="/inventario" class="sidebar-nav-item {{#if (eq currentPath '/inventario')}}active{{/if}}" title="Inventario">
          <i data-lucide="package"></i><span>Inventario</span>
        </a>
        {{/if}}
        {{/if}}

        {{#if isDesarrollador}}
        <a href="/planilla" class="sidebar-nav-item {{#if (eq currentPath '/planilla')}}active{{/if}}" title="Planilla">
          <i data-lucide="wallet"></i><span>Planilla</span>
        </a>
        {{else}}
        {{#if puedeVerPlanilla}}
        {{#if secciones.planilla}}
        <a href="/planilla" class="sidebar-nav-item {{#if (eq currentPath '/planilla')}}active{{/if}}" title="Planilla">
          <i data-lucide="wallet"></i><span>Planilla</span>
        </a>
        {{/if}}
        {{/if}}
        {{/if}}

      </div>
    </div>
    {{/if}}

    {{#if mostrarGrupoAdministracion}}
    <div class="sidebar-group" data-group="administracion">
      <button type="button" class="sidebar-group-header" data-group-toggle="administracion" aria-expanded="true">
        <span class="sidebar-group-header-label"><i data-lucide="briefcase"></i><span>Administración</span></span>
        <i data-lucide="chevron-down" class="sidebar-group-chevron"></i>
      </button>
      <div class="sidebar-group-items" id="sidebarGroup-administracion">
        <div class="sidebar-flyout-titulo">Administración</div>

        {{#if (or isDesarrollador secciones.comprobantes)}}
        <a href="/comprobantes" class="sidebar-nav-item {{#if (eq currentPath '/comprobantes')}}active{{/if}}" title="Comprobantes">
          <i data-lucide="receipt"></i><span>Comprobantes</span>
        </a>
        {{/if}}
        {{#if puedeCrearCodigos}}
        {{#if (or isDesarrollador secciones.codigos)}}
        <a href="/codigos" class="sidebar-nav-item {{#if (eq currentPath '/codigos')}}active{{/if}}" title="Códigos de Autorización">
          <i data-lucide="key-round"></i><span>Códigos de Autorización</span>
        </a>
        {{/if}}
        {{/if}}
        {{#if (or isAdmin user.puede_programar)}}
        {{#if (or isDesarrollador secciones.programacion)}}
        <a href="/programacion" class="sidebar-nav-item {{#if (eq currentPath '/programacion')}}active{{/if}}" title="Programación">
          <i data-lucide="calendar-clock"></i><span>Programación</span>
        </a>
        {{/if}}
        {{/if}}
        {{#if isAdmin}}
        {{#if (or isDesarrollador secciones.usuarios)}}
        <a href="/usuarios" class="sidebar-nav-item {{#if (eq currentPath '/usuarios')}}active{{/if}}" title="Usuarios">
          <i data-lucide="shield-check"></i><span>Usuarios</span>
        </a>
        {{/if}}
        {{#if (or isDesarrollador secciones.empresas)}}
        <a href="/empresas" class="sidebar-nav-item {{#if (eq currentPath '/empresas')}}active{{/if}}" title="Empresas">
          <i data-lucide="building-2"></i><span>Empresas</span>
        </a>
        {{/if}}
        {{#if (or isDesarrollador secciones.[mapa-asientos])}}
        <a href="/mapa-asientos" class="sidebar-nav-item {{#if (eq currentPath '/mapa-asientos')}}active{{/if}}" title="Mapa de Asientos">
          <i data-lucide="layout-dashboard"></i><span>Mapa de Asientos</span>
        </a>
        {{/if}}
        {{/if}}

      </div>
    </div>
    {{/if}}

    {{#if isDesarrollador}}
    <div class="sidebar-group" data-group="desarrollador">
      <button type="button" class="sidebar-group-header" data-group-toggle="desarrollador" aria-expanded="true">
        <span class="sidebar-group-header-label"><i data-lucide="code-2"></i><span>Desarrollador</span></span>
        <i data-lucide="chevron-down" class="sidebar-group-chevron"></i>
      </button>
      <div class="sidebar-group-items" id="sidebarGroup-desarrollador">
        <div class="sidebar-flyout-titulo">Desarrollador</div>
        <a href="/configuracion" class="sidebar-nav-item {{#if (eq currentPath '/configuracion')}}active{{/if}}" title="Configuración">
          <i data-lucide="sliders-horizontal"></i><span>Configuración</span>
        </a>
        <a href="/roles" class="sidebar-nav-item {{#if (eq currentPath '/roles')}}active{{/if}}" title="Roles">
          <i data-lucide="users-round"></i><span>Roles</span>
        </a>
      </div>
    </div>
    {{/if}}

  </nav>

  <!-- Modo nocturno -->
  <div class="sidebar-theme">
    <button type="button" class="sidebar-theme-row" id="themeToggleBtn" title="Cambiar a modo nocturno">
      <span class="sidebar-theme-row-left">
        <i data-lucide="moon" id="themeToggleIcon"></i>
        <span id="themeToggleLabel">Modo nocturno</span>
      </span>
      <span class="theme-switch" id="themeSwitch" aria-hidden="true">
        <span class="theme-switch-knob"></span>
      </span>
    </button>
  </div>

  <!-- Footer -->
  <div class="sidebar-footer">
    <span class="sidebar-version">v1.0.0</span>
    <a href="/logout" class="sidebar-logout" title="Cerrar sesión">
      <i data-lucide="log-out"></i>
    </a>
  </div>

</aside>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
