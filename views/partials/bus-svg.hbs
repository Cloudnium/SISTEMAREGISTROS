<!-- PARTIAL: bus-svg.hbs — Silueta lateral del bus -->
<!-- Diseño fiel al boceto: vista lateral con volante, asiento conductor y escalera -->
<svg viewBox="0 0 120 240" fill="none" xmlns="http://www.w3.org/2000/svg"
     class="ma-bus-silhouette">
  <!-- Carrocería principal -->
  <rect x="8" y="20" width="104" height="200" rx="12"
        fill="#eef0fb" stroke="#6366f1" stroke-width="2.5"/>
  <!-- Parabrisas frontal (arriba) -->
  <rect x="16" y="24" width="88" height="30" rx="6"
        fill="#dde1f8" stroke="#6366f1" stroke-width="1.5"/>
  <!-- Ventanas laterales -->
  <rect x="14" y="64" width="92" height="30" rx="4"
        fill="#dde1f8" stroke="#6366f1" stroke-width="1.5"/>
  <rect x="14" y="104" width="92" height="30" rx="4"
        fill="#dde1f8" stroke="#6366f1" stroke-width="1.5"/>
  <!-- Puerta -->
  <rect x="14" y="144" width="36" height="50" rx="4"
        fill="#c7ccf5" stroke="#6366f1" stroke-width="1.5"/>
  <!-- Línea de la puerta -->
  <line x1="32" y1="144" x2="32" y2="194" stroke="#6366f1" stroke-width="1" stroke-dasharray="3 2"/>
  <!-- Manija puerta -->
  <rect x="34" y="166" width="8" height="3" rx="1.5"
        fill="#6366f1" opacity=".5"/>
  <!-- Ruedas -->
  <ellipse cx="30" cy="222" rx="18" ry="10"
           fill="#c7ccf5" stroke="#6366f1" stroke-width="2"/>
  <ellipse cx="30" cy="222" rx="9" ry="5"
           fill="#eef0fb" stroke="#6366f1" stroke-width="1.5"/>
  <ellipse cx="90" cy="222" rx="18" ry="10"
           fill="#c7ccf5" stroke="#6366f1" stroke-width="2"/>
  <ellipse cx="90" cy="222" rx="9" ry="5"
           fill="#eef0fb" stroke="#6366f1" stroke-width="1.5"/>
  <!-- Volante (conductor) -->
  <circle cx="36" cy="88" r="10"
          fill="none" stroke="#6366f1" stroke-width="2"/>
  <circle cx="36" cy="88" r="3" fill="#6366f1" opacity=".4"/>
  <line x1="36" y1="78" x2="36" y2="98" stroke="#6366f1" stroke-width="1.5"/>
  <line x1="26" y1="88" x2="46" y2="88" stroke="#6366f1" stroke-width="1.5"/>
  <!-- Asiento conductor -->
  <rect x="24" y="100" width="20" height="14" rx="3"
        fill="#c7ccf5" stroke="#6366f1" stroke-width="1.5"/>
  <rect x="26" y="114" width="16" height="5" rx="2"
        fill="#b0b7f0" stroke="#6366f1" stroke-width="1"/>
  <!-- Escalera (icono zigzag) -->
  <line x1="72" y1="72" x2="82" y2="80" stroke="#6366f1" stroke-width="2" stroke-linecap="round"/>
  <line x1="82" y1="80" x2="72" y2="88" stroke="#6366f1" stroke-width="2" stroke-linecap="round"/>
  <line x1="72" y1="88" x2="82" y2="96" stroke="#6366f1" stroke-width="2" stroke-linecap="round"/>
</svg>
