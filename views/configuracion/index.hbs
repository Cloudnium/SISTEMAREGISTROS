<!-- VIEW: configuracion/index.hbs — Visibilidad de secciones (Desarrollador) -->

<div class="card" style="padding:22px 24px">
  <div class="cfg-aviso">
    <i data-lucide="info"></i>
    <span>Combustible, Personal e Inventario siempre están visibles para todos y no aparecen aquí.
    Apaga una sección para ocultarla del menú de todos los usuarios (admin y desarrollador siempre
    pueden seguir entrando, aunque esté apagada).</span>
  </div>

  <h3 style="margin:0 0 12px">Datos de la empresa (aparecen en las boletas de pago de Planilla)</h3>
  <form method="POST" action="/configuracion/empresa" class="cfg-empresa-form" style="margin-bottom:26px">
    <div class="form-group">
      <label class="form-label-pers">Razón social</label>
      <input type="text" name="nombre" class="form-control" value="{{empresa.nombre}}" placeholder="Ej: Transportes Cloudnium S.A.C." />
    </div>
    <div class="form-group">
      <label class="form-label-pers">RUC</label>
      <input type="text" name="ruc" class="form-control" value="{{empresa.ruc}}" placeholder="20123456789" />
    </div>
    <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Guardar</button>
  </form>

  <h3 style="margin:0 0 14px">Visibilidad de secciones</h3>
  <div class="cfg-grid">
    {{#each secciones}}
    <div class="cfg-item">
      <div class="cfg-item-info">
        <i data-lucide="{{icono}}"></i>
        <span>{{nombre}}</span>
      </div>
      <label class="cfg-switch">
        <input type="checkbox" {{#if visible}}checked{{/if}} onchange="Config.toggle('{{clave}}', this)" />
        <span class="cfg-switch-slider"></span>
      </label>
    </div>
    {{/each}}
  </div>
</div>

<style>
.cfg-aviso {
  display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; margin-bottom: 20px;
  background: var(--color-accent-light); border-radius: var(--radius-md); font-size: var(--text-sm); color: var(--text-secondary);
}
.cfg-aviso i { width: 18px; height: 18px; color: var(--color-accent); flex-shrink: 0; margin-top: 1px; }
.cfg-empresa-form { display: flex; gap: 14px; align-items: flex-end; flex-wrap: wrap; }
.cfg-empresa-form .form-group { min-width: 220px; }
.cfg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
.cfg-item {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 14px 16px; border: 1px solid var(--color-border); border-radius: var(--radius-md);
}
.cfg-item-info { display: flex; align-items: center; gap: 10px; font-size: var(--text-sm); font-weight: 600; }
.cfg-item-info i { width: 18px; height: 18px; color: var(--color-accent); }
.cfg-switch { position: relative; display: inline-block; width: 42px; height: 24px; flex-shrink: 0; }
.cfg-switch input { opacity: 0; width: 0; height: 0; }
.cfg-switch-slider {
  position: absolute; cursor: pointer; inset: 0; background: var(--color-border);
  border-radius: 999px; transition: .15s;
}
.cfg-switch-slider::before {
  content: ''; position: absolute; height: 18px; width: 18px; left: 3px; bottom: 3px;
  background: white; border-radius: 50%; transition: .15s;
}
.cfg-switch input:checked + .cfg-switch-slider { background: var(--color-success); }
.cfg-switch input:checked + .cfg-switch-slider::before { transform: translateX(18px); }
</style>

<div class="ma-toast" id="cfgToast"></div>

<script>
var Config = (function () {
  function toast(msg, tipo) {
    var el = document.getElementById('cfgToast');
    el.textContent = msg;
    el.className = 'ma-toast ma-toast-' + (tipo || 'ok') + ' ma-toast-visible';
    setTimeout(function () { el.className = 'ma-toast'; }, 3000);
  }
  function toggle(clave, input) {
    fetch('/configuracion/' + clave + '/toggle', { method: 'POST', credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (r) {
        if (r.error) { toast(r.error, 'error'); input.checked = !input.checked; return; }
        toast(r.visible ? 'Sección visible de nuevo.' : 'Sección ocultada.', 'ok');
      }).catch(function () { toast('Error de conexión.', 'error'); input.checked = !input.checked; });
  }
  return { toggle };
})();
</script>
