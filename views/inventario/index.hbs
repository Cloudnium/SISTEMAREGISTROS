<!-- VIEW: inventario/index.hbs — Almacén por secciones -->

<div class="inv-tabs">
  {{#each categorias}}
  <a href="/inventario?seccion={{clave}}" class="inv-tab {{#if (eq clave ../categoriaActiva.clave)}}active{{/if}}">
    <i data-lucide="{{icono}}"></i><span>{{nombre}}</span>
  </a>
  {{/each}}
  {{#if puedeGestionarInventario}}
  <button type="button" class="inv-tab inv-tab-nueva" onclick="Inv.abrirNuevaSeccion()">
    <i data-lucide="plus"></i><span>Nueva sección</span>
  </button>
  {{/if}}
</div>

<div class="page-header">
  <div></div>
  <div class="inv-acciones">
    {{#if esUniformes}}
    <button type="button" class="btn btn-ghost" onclick="Inv.abrirHistorial()">
      <i data-lucide="history"></i> Historial
    </button>
    {{/if}}
    {{#if puedeGestionarInventario}}
      {{#if esUniformes}}
      <button type="button" class="btn btn-primary" onclick="Inv.abrirNuevo()">
        <i data-lucide="plus"></i> Nuevo Uniforme
      </button>
      {{else}}
      <button type="button" class="btn btn-primary" onclick="Inv.abrirNuevoItem()">
        <i data-lucide="plus"></i> Nuevo Ítem
      </button>
      {{/if}}
    {{/if}}
  </div>
</div>

{{#if esUniformes}}
<div class="card" style="padding:0">
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th>Uniforme</th>
          <th>Descripción</th>
          <th>Precio</th>
          <th>Stock</th>
          <th></th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        {{#each uniformes}}
        <tr {{#unless activo}}style="opacity:.5"{{/unless}}>
          <td style="font-weight:600">{{nombre}}</td>
          <td class="hide-sm" style="color:var(--text-muted);font-size:var(--text-sm)">{{#if descripcion}}{{descripcion}}{{else}}—{{/if}}</td>
          <td>S/ {{precio}}</td>
          <td><span class="badge {{#if stock}}badge-success{{else}}badge-error{{/if}}">{{stock}}</span></td>
          <td>{{#unless activo}}<span class="text-muted" style="font-size:var(--text-xs)">Inactivo</span>{{/unless}}</td>
          <td>
            <div class="inv-acciones">
              <button type="button" class="btn btn-ghost btn-sm" onclick="Inv.abrirStock('{{id}}', '{{nombre}}')">
                <i data-lucide="plus-circle"></i> Stock
              </button>
              <button type="button" class="btn btn-ghost btn-sm" onclick="Inv.abrirEntrega('{{id}}', '{{nombre}}', {{stock}})">
                <i data-lucide="shirt"></i> Entregar
              </button>
              {{#if ../puedeGestionarInventario}}
              <button type="button" class="btn-icon" title="Editar" onclick='Inv.abrirEditar({{{json this}}})'>
                <i data-lucide="pencil"></i>
              </button>
              {{/if}}
            </div>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{#unless uniformes.length}}
    <div class="ciu-empty"><i data-lucide="shirt"></i><span>No hay uniformes registrados en el catálogo.</span></div>
    {{/unless}}
  </div>
</div>
{{else}}
<div class="card" style="padding:0">
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th>Ítem</th>
          <th>Descripción</th>
          <th>Precio</th>
          <th>Stock</th>
          <th></th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr {{#unless activo}}style="opacity:.5"{{/unless}}>
          <td style="font-weight:600">{{nombre}}</td>
          <td class="hide-sm" style="color:var(--text-muted);font-size:var(--text-sm)">{{#if descripcion}}{{descripcion}}{{else}}—{{/if}}</td>
          <td>S/ {{precio}}</td>
          <td><span class="badge {{#if stock}}badge-success{{else}}badge-error{{/if}}">{{stock}}</span></td>
          <td>{{#unless activo}}<span class="text-muted" style="font-size:var(--text-xs)">Inactivo</span>{{/unless}}</td>
          <td>
            <div class="inv-acciones">
              <button type="button" class="btn btn-ghost btn-sm" onclick="Inv.abrirMovItem('{{id}}', '{{nombre}}', 'ingreso')">
                <i data-lucide="plus-circle"></i> Ingreso
              </button>
              <button type="button" class="btn btn-ghost btn-sm" onclick="Inv.abrirMovItem('{{id}}', '{{nombre}}', 'salida', {{stock}})">
                <i data-lucide="minus-circle"></i> Salida
              </button>
              {{#if ../puedeGestionarInventario}}
              <button type="button" class="btn-icon" title="Editar" onclick='Inv.abrirEditarItem({{{json this}}})'>
                <i data-lucide="pencil"></i>
              </button>
              {{/if}}
            </div>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{#unless items.length}}
    <div class="ciu-empty"><i data-lucide="{{categoriaActiva.icono}}"></i><span>No hay ítems registrados en {{categoriaActiva.nombre}}.</span></div>
    {{/unless}}
  </div>
</div>
{{/if}}

<!-- ═══ MODAL: Nuevo / Editar uniforme (solo autorizados) ═══ -->
{{#if puedeGestionarInventario}}
<div class="modal-backdrop" id="invModalForm" style="display:none">
  <div class="modal" style="max-width:460px">
    <div class="modal-header">
      <div class="modal-title" id="invFormTitulo"><i data-lucide="shirt"></i> Nuevo Uniforme</div>
      <button class="modal-close" onclick="Inv.cerrarForm()"><i data-lucide="x"></i></button>
    </div>
    <form id="invForm" method="POST" action="/inventario/uniformes">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label-pers">Nombre (ej. Camisa manga larga - Talla M)</label>
          <input type="text" name="nombre" id="invNombre" class="form-control" required />
        </div>
        <div class="form-group">
          <label class="form-label-pers">Descripción (opcional)</label>
          <input type="text" name="descripcion" id="invDescripcion" class="form-control" />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label-pers">Precio (S/)</label>
            <input type="number" name="precio" id="invPrecio" class="form-control" step="0.01" min="0" required />
          </div>
          <div class="form-group" id="invStockGroup">
            <label class="form-label-pers">Stock inicial</label>
            <input type="number" name="stock" id="invStock" class="form-control" min="0" value="0" />
          </div>
        </div>
        <label class="form-check-label" id="invActivoWrap" style="display:none">
          <input type="checkbox" name="activo" id="invActivo" class="form-check" checked />
          <span>Activo (visible para entregas)</span>
        </label>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="Inv.cerrarForm()">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar</button>
      </div>
    </form>
  </div>
</div>
{{/if}}

<!-- ═══ MODAL: Aumentar stock (todos) ═══ -->
<div class="modal-backdrop" id="invModalStock" style="display:none">
  <div class="modal" style="max-width:380px">
    <div class="modal-header">
      <div class="modal-title"><i data-lucide="plus-circle"></i> Aumentar stock — <span id="invStockNombre"></span></div>
      <button class="modal-close" onclick="Inv.cerrarStock()"><i data-lucide="x"></i></button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label-pers">Cantidad a agregar</label>
        <input type="number" class="form-control" id="invStockCantidad" min="1" value="1" />
      </div>
      <div class="form-group">
        <label class="form-label-pers">Motivo <small class="text-muted">(opcional)</small></label>
        <input type="text" class="form-control" id="invStockMotivo" placeholder="Ej: Compra a proveedor, Ajuste manual de stock..." />
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-ghost" onclick="Inv.cerrarStock()">Cancelar</button>
      <button type="button" class="btn btn-primary" onclick="Inv.confirmarStock()">Agregar</button>
    </div>
  </div>
</div>

<!-- ═══ MODAL: Entregar a personal (todos) ═══ -->
<div class="modal-backdrop" id="invModalEntrega" style="display:none">
  <div class="modal" style="max-width:420px">
    <div class="modal-header">
      <div class="modal-title"><i data-lucide="shirt"></i> Entregar — <span id="invEntregaNombre"></span></div>
      <button class="modal-close" onclick="Inv.cerrarEntrega()"><i data-lucide="x"></i></button>
    </div>
    <div class="modal-body">
      <p class="form-hint" style="margin-top:0">Stock disponible: <b id="invEntregaStockDisp"></b>. Se descontará del stock y se registrará automáticamente como un descuento en la Planilla del trabajador.</p>
      <div class="form-group">
        <label class="form-label-pers">Trabajador</label>
        <select class="form-control" id="invEntregaPersonal">
          <option value="">— Selecciona —</option>
          {{#each personal}}
          <option value="{{id}}">{{etiqueta}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group">
        <label class="form-label-pers">Cantidad</label>
        <input type="number" class="form-control" id="invEntregaCantidad" min="1" value="1" />
      </div>
      <div class="form-group">
        <label class="form-label-pers">Observación <small class="text-muted">(opcional)</small></label>
        <input type="text" class="form-control" id="invEntregaObservacion" placeholder="Ej: 2 camisas talla M, 2 pantalones" />
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-ghost" onclick="Inv.cerrarEntrega()">Cancelar</button>
      <button type="button" class="btn btn-primary" onclick="Inv.confirmarEntrega()">Entregar</button>
    </div>
  </div>
</div>

<!-- ═══ MODAL: Historial de movimientos de Uniformes ═══ -->
<div class="modal-backdrop" id="invModalHistorial" style="display:none">
  <div class="modal" style="max-width:920px">
    <div class="modal-header">
      <div class="modal-title"><i data-lucide="history"></i> Historial de Movimientos — Uniformes</div>
      <button class="modal-close" onclick="Inv.cerrarHistorial()"><i data-lucide="x"></i></button>
    </div>
    <div class="modal-body">
      <div class="inv-hist-filtros">
        <div class="form-group">
          <label class="form-label-pers">Desde</label>
          <input type="date" id="invHistDesde" class="form-control" />
        </div>
        <div class="form-group">
          <label class="form-label-pers">Hasta</label>
          <input type="date" id="invHistHasta" class="form-control" />
        </div>
        <div class="form-group">
          <label class="form-label-pers">Producto</label>
          <select id="invHistProducto" class="form-control">
            <option value="">Todos los productos</option>
            {{#each uniformes}}<option value="{{id}}">{{nombre}}</option>{{/each}}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label-pers">Tipo</label>
          <select id="invHistTipo" class="form-control">
            <option value="todos">Todos</option>
            <option value="ingreso">Entradas</option>
            <option value="entrega">Salidas</option>
            <option value="modificacion">Modificaciones</option>
          </select>
        </div>
        <button type="button" class="btn btn-primary" onclick="Inv.buscarHistorial()"><i data-lucide="search"></i></button>
      </div>

      <div class="inv-hist-resumen">
        <div class="inv-hist-card inv-hist-card-total"><label>Total movimientos</label><span id="invHistTotal">0</span></div>
        <div class="inv-hist-card inv-hist-card-in"><label>Unidades ingresadas</label><span id="invHistIngresadas">+0</span></div>
        <div class="inv-hist-card inv-hist-card-out"><label>Unidades salidas</label><span id="invHistSalidas">-0</span></div>
      </div>

      <div class="table-wrapper" style="max-height:340px">
        <table class="table">
          <thead>
            <tr><th>Fecha</th><th>Hora</th><th>Producto</th><th>Tipo</th><th>Motivo</th><th class="text-right">Cantidad</th><th>Stock</th><th>Usuario</th></tr>
          </thead>
          <tbody id="invHistTbody">
            <tr><td colspan="8" class="text-muted" style="text-align:center;padding:20px">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="modal-footer" style="justify-content:space-between">
      <span class="text-muted" id="invHistContador" style="font-size:12.5px">0 movimientos encontrados</span>
      <div style="display:flex;gap:8px">
        <button type="button" class="btn btn-ghost" onclick="Inv.cerrarHistorial()"><i data-lucide="x"></i> Cerrar</button>
        <button type="button" class="btn btn-ghost" onclick="Inv.exportarHistorialExcel()" style="color:#047857;border-color:#047857"><i data-lucide="file-spreadsheet"></i> Excel</button>
        <button type="button" class="btn btn-ghost" onclick="Inv.imprimirHistorial()" style="color:#b91c1c;border-color:#b91c1c"><i data-lucide="file-down"></i> PDF</button>
      </div>
    </div>
  </div>
</div>
<iframe id="invHistPrintFrame" style="position:fixed;top:-9999px;left:-9999px;width:900px;height:1200px;border:0" title="Impresión de historial"></iframe>

<!-- ═══ MODAL: Nueva / Editar sección (solo autorizados) ═══ -->
{{#if puedeGestionarInventario}}
<div class="modal-backdrop" id="invModalSeccion" style="display:none">
  <div class="modal" style="max-width:400px">
    <div class="modal-header">
      <div class="modal-title" id="invSeccionTitulo"><i data-lucide="folder-plus"></i> Nueva Sección</div>
      <button class="modal-close" onclick="Inv.cerrarNuevaSeccion()"><i data-lucide="x"></i></button>
    </div>
    <form id="invSeccionForm" method="POST" action="/inventario/categorias">
      <div class="modal-body">
        {{#if tiposDisponibles.length}}
        <div class="form-group">
          <label class="form-label-pers">Tipo de sección</label>
          <select name="tipo" id="invSeccionTipo" class="form-control" required onchange="Inv.alElegirTipoSeccion()">
            <option value="" disabled selected>Elige una opción...</option>
            {{#each tiposDisponibles}}
            <option value="{{tipo}}" data-icono="{{icono}}">{{nombre}}</option>
            {{/each}}
          </select>
          <p class="form-hint">Se irán agregando más tipos de sección (con su propio formato) más adelante.</p>
        </div>
        <div class="form-group">
          <label class="form-label-pers">Ícono</label>
          <input type="hidden" name="icono" id="invSeccionIcono" value="package" />
          <div class="inv-icon-grid">
            {{#each iconosDisponibles}}
            <button type="button" class="inv-icon-opcion" data-icono="{{this}}" onclick="Inv.elegirIconoSeccion('{{this}}')" title="{{this}}">
              <i data-lucide="{{this}}"></i>
            </button>
            {{/each}}
          </div>
        </div>
        {{else}}
        <div class="empty-state">
          <i data-lucide="check-circle"></i>
          <p>Ya creaste todas las secciones disponibles por ahora. Se irán agregando más tipos más adelante.</p>
        </div>
        {{/if}}
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="Inv.cerrarNuevaSeccion()">Cancelar</button>
        {{#if tiposDisponibles.length}}<button type="submit" class="btn btn-primary">Guardar</button>{{/if}}
      </div>
    </form>
  </div>
</div>

<!-- ═══ MODAL: Nuevo / Editar ítem genérico (solo autorizados) ═══ -->
<div class="modal-backdrop" id="invModalItem" style="display:none">
  <div class="modal" style="max-width:460px">
    <div class="modal-header">
      <div class="modal-title" id="invItemTitulo"><i data-lucide="box"></i> Nuevo Ítem</div>
      <button class="modal-close" onclick="Inv.cerrarFormItem()"><i data-lucide="x"></i></button>
    </div>
    <form id="invItemForm" method="POST" action="/inventario/items">
      <div class="modal-body">
        <input type="hidden" name="categoria_id" value="{{categoriaActiva.id}}" />
        <div class="form-group">
          <label class="form-label-pers">Nombre</label>
          <input type="text" name="nombre" id="invItemNombre" class="form-control" required />
        </div>
        <div class="form-group">
          <label class="form-label-pers">Descripción (opcional)</label>
          <input type="text" name="descripcion" id="invItemDescripcion" class="form-control" />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label-pers">Precio (S/)</label>
            <input type="number" name="precio" id="invItemPrecio" class="form-control" step="0.01" min="0" />
          </div>
          <div class="form-group" id="invItemStockGroup">
            <label class="form-label-pers">Stock inicial</label>
            <input type="number" name="stock" id="invItemStock" class="form-control" min="0" value="0" />
          </div>
        </div>
        <label class="form-check-label" id="invItemActivoWrap" style="display:none">
          <input type="checkbox" name="activo" id="invItemActivo" class="form-check" checked />
          <span>Activo</span>
        </label>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="Inv.cerrarFormItem()">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar</button>
      </div>
    </form>
  </div>
</div>
{{/if}}

<!-- ═══ MODAL: Ingreso/Salida de stock de ítem genérico (todos) ═══ -->
<div class="modal-backdrop" id="invModalMovItem" style="display:none">
  <div class="modal" style="max-width:380px">
    <div class="modal-header">
      <div class="modal-title" id="invMovItemTitulo"><i data-lucide="plus-circle"></i> Movimiento — <span id="invMovItemNombre"></span></div>
      <button class="modal-close" onclick="Inv.cerrarMovItem()"><i data-lucide="x"></i></button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label-pers">Cantidad</label>
        <input type="number" class="form-control" id="invMovItemCantidad" min="1" value="1" />
      </div>
      <div class="form-group">
        <label class="form-label-pers">Nota (opcional)</label>
        <input type="text" class="form-control" id="invMovItemNotas" placeholder="Motivo, referencia..." />
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-ghost" onclick="Inv.cerrarMovItem()">Cancelar</button>
      <button type="button" class="btn btn-primary" onclick="Inv.confirmarMovItem()">Registrar</button>
    </div>
  </div>
</div>

<div class="ma-toast" id="invToast"></div>

<style>
.inv-acciones { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.inv-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
.inv-tab {
  display: flex; align-items: center; gap: 8px; padding: 10px 16px;
  border-radius: var(--radius-md); border: 1px solid var(--color-border);
  background: var(--color-surface); color: var(--text-secondary); font-size: var(--text-sm);
  font-weight: 600; text-decoration: none; cursor: pointer;
}
.inv-tab i { width: 16px; height: 16px; }
.inv-tab.active { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
.inv-tab-nueva { border-style: dashed; color: var(--text-muted); }
.inv-icon-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-top: 8px; }
.inv-icon-opcion {
  display: flex; align-items: center; justify-content: center;
  width: 100%; aspect-ratio: 1; border-radius: var(--radius-md);
  border: 1.5px solid var(--color-border); background: var(--color-surface);
  color: var(--text-secondary); cursor: pointer; transition: all var(--transition-fast);
}
.inv-icon-opcion:hover { border-color: var(--color-accent); color: var(--color-accent); }
.inv-icon-opcion.activo { border-color: var(--color-accent); background: var(--color-accent-light); color: var(--color-accent); }
.inv-icon-opcion svg { width: 18px; height: 18px; }

.inv-hist-filtros { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; margin-bottom: 16px; }
.inv-hist-filtros .form-group { margin-bottom: 0; min-width: 140px; }
.inv-hist-resumen { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 16px; }
.inv-hist-card { border-radius: var(--radius-md); padding: 12px 16px; border: 1px solid var(--color-border); }
.inv-hist-card label { display: block; font-size: 11px; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 4px; }
.inv-hist-card span { font-size: 19px; font-weight: 700; }
.inv-hist-card-total { background: var(--color-accent-light); }
.inv-hist-card-in { background: var(--color-success-light); }
.inv-hist-card-in span { color: var(--color-success); }
.inv-hist-card-out { background: var(--color-error-light); }
.inv-hist-card-out span { color: var(--color-error); }
</style>

<script>
var Inv = (function () {
  var uniformeActualId = null, stockDisponibleActual = 0;
  var itemActualId = null, itemMovTipo = 'ingreso', itemStockDisp = 0;

  function toast(msg, tipo) {
    var el = document.getElementById('invToast');
    el.textContent = msg;
    el.className = 'ma-toast ma-toast-' + (tipo || 'ok') + ' ma-toast-visible';
    setTimeout(function () { el.className = 'ma-toast'; }, 3000);
  }

  function abrirNuevo() {
    var form = document.getElementById('invForm');
    if (!form) return;
    form.action = '/inventario/uniformes';
    form.reset();
    document.getElementById('invFormTitulo').innerHTML = '<i data-lucide="shirt"></i> Nuevo Uniforme';
    document.getElementById('invStockGroup').style.display = '';
    document.getElementById('invActivoWrap').style.display = 'none';
    document.getElementById('invModalForm').style.display = 'flex';
    if (window.lucide) lucide.createIcons();
  }
  function abrirEditar(u) {
    var form = document.getElementById('invForm');
    if (!form) return;
    form.action = '/inventario/uniformes/' + u.id + '/editar';
    document.getElementById('invNombre').value = u.nombre || '';
    document.getElementById('invDescripcion').value = u.descripcion || '';
    document.getElementById('invPrecio').value = u.precio || 0;
    document.getElementById('invActivo').checked = !!u.activo;
    document.getElementById('invFormTitulo').innerHTML = '<i data-lucide="pencil"></i> Editar Uniforme';
    document.getElementById('invStockGroup').style.display = 'none';
    document.getElementById('invActivoWrap').style.display = '';
    document.getElementById('invModalForm').style.display = 'flex';
    if (window.lucide) lucide.createIcons();
  }
  function cerrarForm() { document.getElementById('invModalForm').style.display = 'none'; }

  function abrirStock(id, nombre) {
    uniformeActualId = id;
    document.getElementById('invStockNombre').textContent = nombre;
    document.getElementById('invStockCantidad').value = 1;
    document.getElementById('invStockMotivo').value = '';
    document.getElementById('invModalStock').style.display = 'flex';
  }
  function cerrarStock() { document.getElementById('invModalStock').style.display = 'none'; }
  function confirmarStock() {
    var cantidad = document.getElementById('invStockCantidad').value;
    var motivo = document.getElementById('invStockMotivo').value;
    if (!cantidad || Number(cantidad) <= 0) { toast('Ingresa una cantidad válida.', 'error'); return; }
    fetch('/inventario/uniformes/' + uniformeActualId + '/stock', {
      method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ cantidad: cantidad, motivo: motivo })
    }).then(function (r) { return r.json(); }).then(function (r) {
      if (r.error) { toast(r.error, 'error'); return; }
      toast('Stock actualizado.', 'ok');
      setTimeout(function () { location.reload(); }, 500);
    });
  }

  function abrirEntrega(id, nombre, stockDisp) {
    uniformeActualId = id; stockDisponibleActual = stockDisp;
    document.getElementById('invEntregaNombre').textContent = nombre;
    document.getElementById('invEntregaStockDisp').textContent = stockDisp;
    document.getElementById('invEntregaPersonal').value = '';
    document.getElementById('invEntregaCantidad').value = 1;
    document.getElementById('invEntregaObservacion').value = '';
    document.getElementById('invModalEntrega').style.display = 'flex';
  }
  function cerrarEntrega() { document.getElementById('invModalEntrega').style.display = 'none'; }
  function confirmarEntrega() {
    var personalId = document.getElementById('invEntregaPersonal').value;
    var cantidad = document.getElementById('invEntregaCantidad').value;
    if (!personalId) { toast('Selecciona el trabajador.', 'error'); return; }
    if (!cantidad || Number(cantidad) <= 0) { toast('Ingresa una cantidad válida.', 'error'); return; }
    if (Number(cantidad) > stockDisponibleActual) { toast('No hay stock suficiente.', 'error'); return; }
    fetch('/inventario/uniformes/' + uniformeActualId + '/entregar', {
      method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ personal_id: personalId, cantidad: cantidad, observacion: document.getElementById('invEntregaObservacion').value })
    }).then(function (r) { return r.json(); }).then(function (r) {
      if (r.error) { toast(r.error, 'error'); return; }
      toast('Entrega registrada. Se generó el descuento en Planilla.', 'ok');
      setTimeout(function () { location.reload(); }, 700);
    });
  }

  // ── Historial de movimientos (Uniformes) ──
  function abrirHistorial() {
    document.getElementById('invModalHistorial').style.display = 'flex';
    buscarHistorial();
  }
  function cerrarHistorial() { document.getElementById('invModalHistorial').style.display = 'none'; }

  function paramsHistorial() {
    var p = new URLSearchParams();
    var desde = document.getElementById('invHistDesde').value;
    var hasta = document.getElementById('invHistHasta').value;
    var producto = document.getElementById('invHistProducto').value;
    var tipo = document.getElementById('invHistTipo').value;
    if (desde) p.set('desde', desde);
    if (hasta) p.set('hasta', hasta);
    if (producto) p.set('uniforme_id', producto);
    if (tipo) p.set('tipo', tipo);
    return p;
  }

  function escHtml(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }

  function buscarHistorial() {
    var tbody = document.getElementById('invHistTbody');
    tbody.innerHTML = '<tr><td colspan="8" class="text-muted" style="text-align:center;padding:20px">Cargando...</td></tr>';
    fetch('/inventario/uniformes/historial?' + paramsHistorial().toString(), { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        document.getElementById('invHistTotal').textContent = data.totalMovimientos;
        document.getElementById('invHistIngresadas').textContent = '+' + data.unidadesIngresadas;
        document.getElementById('invHistSalidas').textContent = '-' + data.unidadesSalidas;
        document.getElementById('invHistContador').textContent = data.totalMovimientos + ' movimiento' + (data.totalMovimientos === 1 ? '' : 's') + ' encontrado' + (data.totalMovimientos === 1 ? '' : 's');

        if (!data.movimientos.length) {
          tbody.innerHTML = '<tr><td colspan="8" class="text-muted" style="text-align:center;padding:20px">Sin movimientos para estos filtros.</td></tr>';
          return;
        }
        var badgeClase = { ingreso: 'badge-success', entrega: 'badge-error', modificacion: 'badge-neutral' };
        tbody.innerHTML = data.movimientos.map(function (m) {
          var cantidadTxt = m.signoCantidad ? (m.signoCantidad > 0 ? '+' : '') + m.signoCantidad : '—';
          var stockTxt = m.stockAnterior != null ? (m.stockAnterior + ' → ' + m.stockNuevo) : (m.stockNuevo != null ? m.stockNuevo : '—');
          return '<tr>' +
            '<td>' + m.fechaMostrar + '</td>' +
            '<td>' + m.horaMostrar + '</td>' +
            '<td><b>' + escHtml(m.producto) + '</b></td>' +
            '<td><span class="badge ' + (badgeClase[m.tipo] || 'badge-neutral') + '">' + m.tipoMostrar + '</span></td>' +
            '<td>' + escHtml(m.motivo) + '</td>' +
            '<td class="text-right">' + cantidadTxt + '</td>' +
            '<td>' + stockTxt + '</td>' +
            '<td>' + escHtml(m.usuario) + '</td>' +
          '</tr>';
        }).join('');
      });
  }

  function exportarHistorialExcel() {
    window.location.href = '/inventario/uniformes/historial/exportar.xlsx?' + paramsHistorial().toString();
  }

  function imprimirHistorial() {
    document.getElementById('invHistPrintFrame').src = '/inventario/uniformes/historial/imprimir?' + paramsHistorial().toString();
  }

  // ── Secciones ──
  function abrirNuevaSeccion() {
    var form = document.getElementById('invSeccionForm');
    if (!form) return;
    form.reset();
    elegirIconoSeccion('package');
    document.getElementById('invModalSeccion').style.display = 'flex';
  }
  function cerrarNuevaSeccion() { document.getElementById('invModalSeccion').style.display = 'none'; }

  function alElegirTipoSeccion() {
    var select = document.getElementById('invSeccionTipo');
    var opcion = select.options[select.selectedIndex];
    var iconoSugerido = opcion && opcion.getAttribute('data-icono');
    if (iconoSugerido) elegirIconoSeccion(iconoSugerido);
  }

  function elegirIconoSeccion(nombreIcono) {
    document.getElementById('invSeccionIcono').value = nombreIcono;
    Array.prototype.forEach.call(document.querySelectorAll('.inv-icon-opcion'), function (btn) {
      btn.classList.toggle('activo', btn.getAttribute('data-icono') === nombreIcono);
    });
  }

  // ── Ítems genéricos ──
  function abrirNuevoItem() {
    var form = document.getElementById('invItemForm');
    if (!form) return;
    form.action = '/inventario/items';
    form.reset();
    document.getElementById('invItemTitulo').innerHTML = '<i data-lucide="box"></i> Nuevo Ítem';
    document.getElementById('invItemStockGroup').style.display = '';
    document.getElementById('invItemActivoWrap').style.display = 'none';
    document.getElementById('invModalItem').style.display = 'flex';
    if (window.lucide) lucide.createIcons();
  }
  function abrirEditarItem(it) {
    var form = document.getElementById('invItemForm');
    if (!form) return;
    form.action = '/inventario/items/' + it.id + '/editar';
    document.getElementById('invItemNombre').value = it.nombre || '';
    document.getElementById('invItemDescripcion').value = it.descripcion || '';
    document.getElementById('invItemPrecio').value = it.precio || 0;
    document.getElementById('invItemActivo').checked = !!it.activo;
    document.getElementById('invItemTitulo').innerHTML = '<i data-lucide="pencil"></i> Editar Ítem';
    document.getElementById('invItemStockGroup').style.display = 'none';
    document.getElementById('invItemActivoWrap').style.display = '';
    document.getElementById('invModalItem').style.display = 'flex';
    if (window.lucide) lucide.createIcons();
  }
  function cerrarFormItem() { document.getElementById('invModalItem').style.display = 'none'; }

  function abrirMovItem(id, nombre, tipo, stockDisp) {
    itemActualId = id; itemMovTipo = tipo; itemStockDisp = stockDisp || 0;
    document.getElementById('invMovItemTitulo').innerHTML =
      (tipo === 'ingreso' ? '<i data-lucide="plus-circle"></i> Ingreso — ' : '<i data-lucide="minus-circle"></i> Salida — ') +
      '<span id="invMovItemNombre">' + nombre + '</span>';
    document.getElementById('invMovItemCantidad').value = 1;
    document.getElementById('invMovItemNotas').value = '';
    document.getElementById('invModalMovItem').style.display = 'flex';
    if (window.lucide) lucide.createIcons();
  }
  function cerrarMovItem() { document.getElementById('invModalMovItem').style.display = 'none'; }
  function confirmarMovItem() {
    var cantidad = document.getElementById('invMovItemCantidad').value;
    if (!cantidad || Number(cantidad) <= 0) { toast('Ingresa una cantidad válida.', 'error'); return; }
    if (itemMovTipo === 'salida' && Number(cantidad) > itemStockDisp) { toast('No hay stock suficiente.', 'error'); return; }
    fetch('/inventario/items/' + itemActualId + '/movimiento', {
      method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tipo: itemMovTipo, cantidad: cantidad, notas: document.getElementById('invMovItemNotas').value })
    }).then(function (r) { return r.json(); }).then(function (r) {
      if (r.error) { toast(r.error, 'error'); return; }
      toast('Movimiento registrado.', 'ok');
      setTimeout(function () { location.reload(); }, 500);
    });
  }

  return {
    abrirNuevo, abrirEditar, cerrarForm, abrirStock, cerrarStock, confirmarStock, abrirEntrega, cerrarEntrega, confirmarEntrega,
    abrirNuevaSeccion, cerrarNuevaSeccion, alElegirTipoSeccion, elegirIconoSeccion,
    abrirHistorial, cerrarHistorial, buscarHistorial, exportarHistorialExcel, imprimirHistorial,
    abrirNuevoItem, abrirEditarItem, cerrarFormItem, abrirMovItem, cerrarMovItem, confirmarMovItem
  };
})();
</script>
