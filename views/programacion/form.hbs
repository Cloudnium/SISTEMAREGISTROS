<!-- VIEW: programacion/form.hbs — Nueva/Editar Programación de Salida -->

<div class="prog-form-wrapper">
<form action="{{#if (eq accion 'editar')}}/programacion/{{prog.id}}/editar{{else}}/programacion{{/if}}" method="POST" id="formProg">

  <!-- ═══════════════════════════════════════
       SECCIÓN 1: Datos de Control e Itinerario
  ═══════════════════════════════════════ -->
  <div class="prog-seccion">
    <div class="prog-seccion-titulo">
      <i data-lucide="bus"></i>
      <span>1. Datos de Control e Itinerario Base</span>
    </div>
    <div class="prog-grid-4">

      <div class="prog-field">
        <label class="prog-label">Fecha de Salida</label>
        <input type="date" name="fecha_salida" id="progFechaSalida" class="form-control prog-input"
               value="{{prog.fecha_salida}}" required />
      </div>

      {{#unless (eq accion 'editar')}}
      <div class="prog-field">
        <label class="prog-label prog-check-inline">
          <input type="checkbox" id="progRangoToggle" onchange="toggleRangoFechas(this.checked)" />
          Repetir todos los días hasta…
        </label>
        <input type="date" name="fecha_hasta" id="progFechaHasta" class="form-control prog-input" disabled />
        <small class="form-hint">Crea una programación idéntica para cada día entre ambas fechas.</small>
      </div>
      {{/unless}}

      <script>
        function toggleRangoFechas(activo) {
          var input = document.getElementById('progFechaHasta');
          if (!input) return;
          input.disabled = !activo;
          if (!activo) input.value = '';
        }
      </script>

      <div class="prog-field">
        <label class="prog-label">Destino Comercial</label>
        <select name="destino_id" class="form-control prog-input" required>
          <option value="">Selecciona destino</option>
          {{#each destinos}}
          <option value="{{id}}" {{#if (eq id ../prog.destino_id)}}selected{{/if}}>
            {{ciudades_origen.nombre}} - {{ciudades_destino.nombre}}
          </option>
          {{/each}}
        </select>
      </div>

      <div class="prog-field">
        <label class="prog-label">Tipo Servicio</label>
        <select name="servicio_id" class="form-control prog-input">
          <option value="">Sin servicio</option>
          {{#each servicios}}
          <option value="{{id}}" {{#if (eq id ../prog.servicio_id)}}selected{{/if}}>{{nombre}}</option>
          {{/each}}
        </select>
      </div>

      <div class="prog-field">
        <label class="prog-label">Asignar Bus (Placa)</label>
        <select name="bus_id" class="form-control prog-input">
          <option value="">Sin bus asignado</option>
          {{#each buses}}
          <option value="{{id}}" {{#if (eq id ../prog.bus_id)}}selected{{/if}}>{{placa}}{{#if marca}} ({{marca}}){{/if}}</option>
          {{/each}}
        </select>
      </div>

    </div>
  </div>

  <!-- ═══════════════════════════════════════
       SECCIÓN 2: Personal de Tripulación
  ═══════════════════════════════════════ -->
  <div class="prog-seccion">
    <div class="prog-seccion-titulo">
      <i data-lucide="users"></i>
      <span>2. Personal de Tripulación Requerido</span>
    </div>
    <div class="prog-grid-4">

      <div class="prog-field">
        <label class="prog-label">Piloto (Conductor 1)</label>
        <select name="piloto_id" class="form-control prog-input" required>
          <option value="">Selecciona piloto</option>
          {{#each choferes}}
          <option value="{{id}}" {{#if (eq id ../prog.piloto_id)}}selected{{/if}}>
            {{nombres}} {{apellidos}}{{#if licencia}} (Lic: {{licencia}}){{/if}}
          </option>
          {{/each}}
        </select>
      </div>

      <div class="prog-field">
        <label class="prog-label">Copiloto 1 (Conductor 2)</label>
        <select name="copiloto1_id" class="form-control prog-input">
          <option value="">Ninguno</option>
          {{#each choferes}}
          <option value="{{id}}" {{#if (eq id ../prog.copiloto1_id)}}selected{{/if}}>
            {{nombres}} {{apellidos}}{{#if licencia}} (Lic: {{licencia}}){{/if}}
          </option>
          {{/each}}
        </select>
      </div>

      <div class="prog-field">
        <label class="prog-label">Copiloto 2 (Opcional)</label>
        <select name="copiloto2_id" class="form-control prog-input">
          <option value="">Ninguno</option>
          {{#each choferes}}
          <option value="{{id}}" {{#if (eq id ../prog.copiloto2_id)}}selected{{/if}}>
            {{nombres}} {{apellidos}}{{#if licencia}} (Lic: {{licencia}}){{/if}}
          </option>
          {{/each}}
        </select>
      </div>

      <div class="prog-field">
        <label class="prog-label">Terramoza</label>
        <select name="terramoza_id" class="form-control prog-input">
          <option value="">Ninguna</option>
          {{#each terramozas}}
          <option value="{{id}}" {{#if (eq id ../prog.terramoza_id)}}selected{{/if}}>
            {{nombres}} {{apellidos}}
          </option>
          {{/each}}
        </select>
      </div>

      <div class="prog-field">
        <label class="prog-label">Ayudante</label>
        <select name="ayudante_id" class="form-control prog-input">
          <option value="">Ninguno</option>
          {{#each ayudantes}}
          <option value="{{id}}" {{#if (eq id ../prog.ayudante_id)}}selected{{/if}}>
            {{nombres}} {{apellidos}}
          </option>
          {{/each}}
        </select>
      </div>

    </div>
  </div>

  <!-- ═══════════════════════════════════════
       SECCIONES 3 y 4 en dos columnas
  ═══════════════════════════════════════ -->
  <div class="prog-bottom-row">

    <!-- SECCIÓN 3: Escala y Ruta -->
    <div class="prog-seccion prog-seccion-escalas">
      <div class="prog-seccion-titulo">
        <i data-lucide="map-pin"></i>
        <span>3. Escala y Ruta de Agencias (Máx 6 puntos)</span>
      </div>

      {{!-- 6 filas de escala: agencia + hora. escalasByOrden viene del
            servidor como { "1": {agencia_id,hora}, "2": {...}, ... } en
            modo editar, y vacío en modo nueva. --}}
      {{#each (range 1 6) as |n|}}
      <div class="prog-escala-row">
        <span class="prog-escala-num">{{n}}° Pte:</span>
        <select name="agencia_{{n}}" class="form-control prog-input prog-escala-select">
          <option value="">-- Seleccionar Agencia Alterna --</option>
          {{#each ../agencias}}
          <option value="{{id}}" {{#if (eq id (lookup (lookup @root.escalasByOrden n) 'agencia_id'))}}selected{{/if}}>{{nombre}}</option>
          {{/each}}
        </select>
        <input type="time" name="hora_{{n}}" class="form-control prog-input prog-escala-hora"
               value="{{lookup (lookup @root.escalasByOrden n) 'hora'}}" />
      </div>
      {{/each}}

    </div>

    <!-- SECCIÓN 4: Tarifas -->
    <div class="prog-seccion prog-seccion-tarifas">
      <div class="prog-seccion-titulo">
        <i data-lucide="tag"></i>
        <span>4. Estructura tarifaria (S/.)</span>
      </div>

      <div class="prog-field">
        <label class="prog-label">Precio 1er Piso</label>
        <input type="number" name="precio_piso1" class="form-control prog-input prog-precio"
               placeholder="150.00" step="0.01" min="0" value="{{prog.precio_piso1}}" />
      </div>

      <div class="prog-field" style="margin-top:var(--space-3)">
        <label class="prog-label">Precio 2do Piso</label>
        <input type="number" name="precio_piso2" class="form-control prog-input prog-precio"
               placeholder="130.00" step="0.01" min="0" value="{{prog.precio_piso2}}" />
      </div>
    </div>

  </div><!-- fin prog-bottom-row -->

  <!-- Botones -->
  <div class="prog-footer">
    <a href="/programacion" class="btn btn-ghost prog-btn-descartar">
      Cancelar
    </a>
    <button type="submit" class="btn btn-primary prog-btn-publicar">
      {{#if (eq accion 'editar')}}
      <i data-lucide="save"></i> Guardar Cambios
      {{else}}
      <i data-lucide="send"></i> Publicar e Iniciar Ventas
      {{/if}}
    </button>
  </div>

</form>
</div><!-- fin prog-form-wrapper -->
