<!-- VIEW: boletaje/index.hbs — Boletaje e Itinerarios -->

<!-- ── Filtros de búsqueda ── -->
<div class="bol-filtros card">
  <form action="/boletaje" method="GET" class="bol-filtros-form">
    <div class="bol-filtro-campo">
      <label class="bol-label">Fecha de Salida</label>
      <input type="date" name="fecha" class="form-control bol-input"
             value="{{filtroFecha}}" required />
    </div>
    <div class="bol-filtro-campo">
      <label class="bol-label">Destino / Ruta</label>
      <select name="destino_id" class="form-control bol-input">
        <option value="">Todos los destinos</option>
        {{#each destinos}}
        <option value="{{id}}" {{#if (eq id ../filtroDestino)}}selected{{/if}}>
          {{ciudades_origen.nombre}} - {{ciudades_destino.nombre}}
        </option>
        {{/each}}
      </select>
    </div>
    <button type="submit" class="btn btn-primary bol-btn-buscar">
      <i data-lucide="search"></i> Buscar Salidas
    </button>
  </form>
</div>

<!-- ── Resultados: agrupados por ruta ── -->
{{#if grupos.length}}
  {{#each grupos}}
  <div class="bol-grupo-ruta">
    <div class="bol-grupo-ruta-titulo">
      <i data-lucide="route"></i>
      <span class="bol-grupo-origen">{{rutaOrigen}}</span>
      <span class="bol-grupo-flecha">→</span>
      <span class="bol-grupo-destino">{{rutaDestino}}</span>
      <span class="bol-grupo-cant">{{salidas.length}} salida{{#if (gt salidas.length 1)}}s{{/if}}</span>
    </div>
  <div class="card">
    <div class="table-wrapper">
      <table class="table bol-table">
        <thead>
          <tr>
            <th>Empresa</th>
            <th>Servicio</th>
            <th>Ruta e Itinerario de Agencias</th>
            <th>Precios</th>
            <th class="hide-sm">Bus / Placa</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          {{#each salidas}}
          <tr class="bol-row bol-row-clickable" onclick="BOL.abrirCroquis('{{id}}')" title="Ver croquis y vender asientos">

            <!-- EMPRESA -->
            <td class="bol-empresa-cell">
              {{#if buses.empresas}}
                {{#if buses.empresas.logo_data_url}}
                <img src="{{buses.empresas.logo_data_url}}" alt="{{buses.empresas.razon_social}}"
                     title="{{buses.empresas.razon_social}}" class="bol-empresa-logo" />
                {{else}}
                <span class="bol-empresa-logo bol-empresa-logo-vacio" title="{{buses.empresas.razon_social}}">
                  <i data-lucide="building-2"></i>
                </span>
                {{/if}}
              {{else}}
                <span class="text-muted">—</span>
              {{/if}}
            </td>

            <!-- SERVICIO -->
            <td>
              {{#if servicios}}
                <span class="bol-srv-badge">{{servicios.nombre}}</span>
              {{else}}
                <span class="text-muted">—</span>
              {{/if}}
            </td>

            <!-- RUTA E ITINERARIO -->
            <td class="bol-ruta-cell">
              {{#if escalas.length}}
                {{#each escalas}}
                <div class="bol-escala-item">
                  <span class="bol-pin"><i data-lucide="map-pin"></i></span>
                  <span class="bol-escala-orden">{{ordinalEs orden}}:</span>
                  <span class="bol-escala-nombre">
                    {{#if agencias}}{{agencias.nombre}}{{else}}—{{/if}}
                  </span>
                  {{#if hora}}
                  <span class="bol-escala-hora">({{hora}})</span>
                  {{/if}}
                </div>
                {{/each}}
              {{else}}
                <span class="text-muted">Sin escalas registradas</span>
              {{/if}}
            </td>

            <!-- PRECIOS -->
            <td class="bol-precios-cell">
              <div class="bol-precio-item">
                <span class="bol-precio-label">1er Piso:</span>
                <span class="bol-precio-val">
                  {{#if precio_piso1}}S/. {{precio_piso1}}{{else}}—{{/if}}
                </span>
              </div>
              <div class="bol-precio-item">
                <span class="bol-precio-label">2do Piso:</span>
                <span class="bol-precio-val">
                  {{#if precio_piso2}}S/. {{precio_piso2}}{{else}}—{{/if}}
                </span>
              </div>
            </td>

            <!-- BUS / PLACA -->
            <td class="hide-sm bol-bus-cell">
              {{#if buses}}
                <div><span class="bol-bus-label">Placa:</span> <strong>{{buses.placa}}</strong></div>
                {{#if buses.total_asientos}}
                <div style="margin-top:2px">
                  <span class="bol-bus-label">Nro Bus:</span> {{buses.total_asientos}}
                </div>
                {{/if}}
              {{else}}
                <span class="text-muted">—</span>
              {{/if}}
            </td>

            <!-- ACCIONES: Croquis y Manifiesto (no abren la venta; eso lo hace la fila) -->
            <td onclick="event.stopPropagation()">
              <div class="bol-acciones">
                <button class="btn btn-sm bol-btn-croquis" title="Ver / editar croquis del bus"
                        onclick="event.stopPropagation();BOL.abrirTripulacion('{{id}}','croquis')">
                  <i data-lucide="bus"></i> Croquis
                </button>
                <button class="btn btn-sm bol-btn-manifiesto" title="Ver / editar manifiesto"
                        onclick="event.stopPropagation();BOL.abrirTripulacion('{{id}}','manifiesto')">
                  <i data-lucide="file-text"></i> Manifiesto
                </button>
                {{#if ../../puedeEditarPrecios}}
                <button class="btn btn-sm bol-btn-editar-precio"
                        title="Editar precio / horario"
                        onclick="event.stopPropagation();BOL.abrirEditarPrecio('{{id}}','{{precio_piso1}}','{{precio_piso2}}','{{#if escalas.[0]}}{{escalas.[0].hora}}{{/if}}')">
                  <i data-lucide="pencil"></i> Editar precio
                </button>
                {{/if}}
              </div>
            </td>

          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  </div>
  {{/each}}
{{else}}
<!-- Sin resultados para esa fecha/destino -->
<div class="card">
  <div class="empty-state">
    <i data-lucide="calendar-x"></i>
    <p>No hay salidas publicadas para los filtros seleccionados.</p>
  </div>
</div>
{{/if}}

<style>
@media (max-width: 639px) { .hide-sm { display: none; } }
</style>

<!-- ═══════════════════════════════════════════════
     MODAL: Croquis / Venta de Asientos
     ═══════════════════════════════════════════════ -->
<div class="modal-backdrop" id="bolModalCroquis" style="display:none">
  <div class="modal bol-modal-venta">
    <div class="modal-header">
      <div class="modal-title"><i data-lucide="bus"></i> Venta de Asientos</div>
      <button class="modal-close" onclick="BOL.cerrar()"><i data-lucide="x"></i></button>
    </div>

    <div class="modal-body bol-venta-body">

      <div class="bol-venta-topbar">
        <div class="bol-venta-warning" id="bolWarning" style="display:none">
          <i data-lucide="alert-triangle"></i>
          Los asientos panorámicos (segundo piso) no pueden ser ocupados por menores
        </div>
        <div class="bol-venta-usuario">
          <i data-lucide="user"></i> <span id="bolUsuarioBadge">—</span>
        </div>
      </div>

      <!-- Tabs de piso + leyenda de estados -->
      <div class="bol-tabs-row">
        <div class="ma-tabs" id="bolTabs" style="display:none">
          <button class="ma-tab ma-tab-active" id="bolTab1" onclick="BOL.cambiarTab(1)">Primer Piso</button>
          <button class="ma-tab" id="bolTab2" onclick="BOL.cambiarTab(2)" style="display:none">Segundo Piso</button>
        </div>
        <div class="bol-leyenda">
          <span class="bol-leyenda-item"><i class="bol-dot bol-dot-libre"></i>Libre</span>
          <span class="bol-leyenda-item"><i class="bol-dot bol-dot-reservado"></i>Reservado</span>
          <span class="bol-leyenda-item"><i class="bol-dot" style="background:#111827"></i>Transferido de otra empresa</span>
          <span class="bol-leyenda-item"><i class="bol-dot" style="background:#9333ea"></i>Reintegro</span>
        </div>
      </div>
      <div class="bol-leyenda bol-leyenda-agencias" id="bolLeyendaAgencias" style="display:none"></div>

      <!-- Croquis del bus -->
      <div id="bolVistaPiso1">
        <div class="ma-bus-scroll">
          <div class="ma-bus-frame" id="bolFrameP1">
            <div class="ma-grid-wrap"><div class="ma-filas" id="bolFilasP1"></div></div>
          </div>
        </div>
      </div>
      <div id="bolVistaPiso2" style="display:none">
        <div class="ma-bus-scroll">
          <div class="ma-bus-frame" id="bolFrameP2">
            <div class="ma-grid-wrap"><div class="ma-filas" id="bolFilasP2"></div></div>
          </div>
        </div>
      </div>

      <!-- Ruta / hora / fecha / selección -->
      <div class="bol-seccion-titulo"><i data-lucide="route"></i> Ruta y horario</div>
      <div class="bol-venta-ruta">
        <div class="bol-venta-ruta-titulo">
          <i data-lucide="route"></i>
          <span id="bolRuta">—</span>
        </div>
        <div class="bol-venta-ruta-meta">
          <div><label>Hora</label><span id="bolHora">—</span></div>
          <div><label>Fecha</label><span id="bolFecha">—</span></div>
        </div>
        <div class="bol-venta-seleccion" id="bolSeleccionPanel" style="display:none">
          <label>Asientos seleccionados</label>
          <div class="bol-venta-seleccion-fila">
            <strong id="bolAsientoSel">—</strong>
            <span class="bol-venta-seleccion-precio" id="bolPrecioSel">S/ 0.00</span>
          </div>
          <div class="bol-venta-seleccion-piso" id="bolPisoSel">Piso 1</div>
        </div>
      </div>

      <!-- Comprobante: SIEMPRE visible, muestra la serie/correlativo del
           asiento actualmente seleccionado (o un estado vacío si no hay
           ninguno seleccionado todavía). -->
      <div class="bol-venta-serie-box" id="bolSerieBox">
        <i data-lucide="receipt"></i>
        <div class="bol-venta-serie-texto">
          <span class="bol-venta-serie-label">Comprobante</span>
          <span id="bolSerieSel">Selecciona un asiento para ver su número de boleto</span>
        </div>
      </div>

      <!-- Origen / Destino (agencias) -->
      <div class="bol-seccion-titulo"><i data-lucide="map-pin"></i> Agencias y tipo de venta</div>
      <div class="bol-venta-row">
        <div>
          <label>Origen (agencia de embarque)</label>
          <select class="form-control" id="bolAgenciaOrigen"><option value="">— Selecciona —</option></select>
        </div>
        <div>
          <label>Destino (agencia de llegada)</label>
          <select class="form-control" id="bolAgenciaDestino"><option value="">— Selecciona —</option></select>
        </div>
        <div>
          <label>Tipo</label>
          <select class="form-control" id="bolTipoMov">
            <option value="venta">Venta</option>
            <option value="reserva">Reserva</option>
          </select>
        </div>
        <div>
          <label>Código de autorización</label>
          <div class="bol-input-btn">
            <input type="text" class="form-control" id="bolCodigo" placeholder="Código"
                   oninput="this.value=this.value.toUpperCase()"
                   onkeydown="if(event.key==='Enter'){event.preventDefault();BOL.validarCodigo();}" />
            <button type="button" onclick="BOL.validarCodigo()">Validar</button>
          </div>
          <small class="bol-codigo-hint" id="bolCodigoHint"></small>
        </div>
        <div>
          <label>Método de pago</label>
          <select class="form-control" id="bolMetodoPago">
            <option value="efectivo">Efectivo</option>
            <option value="tarjeta">Tarjeta</option>
            <option value="yape">Yape</option>
            <option value="plin">Plin</option>
            <option value="transferencia">Transferencia</option>
          </select>
        </div>
      </div>

      <!-- Datos del cliente -->
      <div class="bol-seccion-titulo"><i data-lucide="user-round"></i> Datos del pasajero</div>
      <div class="bol-venta-row">
        <div>
          <label>Documento</label>
          <select class="form-control" id="bolTipoDoc">
            <option value="DNI">D.N.I.</option>
            <option value="CE">Carné Ext.</option>
            <option value="PASAPORTE">Pasaporte</option>
          </select>
        </div>
        <div>
          <label>Número</label>
          <div class="bol-input-btn">
            <button type="button" onclick="BOL.buscarDni()">Buscar Nro.</button>
            <input type="text" class="form-control" id="bolNumDoc" placeholder="00000000" />
          </div>
        </div>
        <div style="flex:2">
          <label>Nombre completo</label>
          <input type="text" class="form-control" id="bolNombre" placeholder="Nombre completo" />
        </div>
        <div>
          <label>Edad</label>
          <input type="number" class="form-control" id="bolEdad" placeholder="Edad" min="0" max="120" />
        </div>
      </div>
      <div class="bol-venta-row">
        <div>
          <label>Teléfono</label>
          <input type="text" class="form-control" id="bolTelefono" placeholder="999 999 999" />
        </div>
        <div>
          <label>RUC</label>
          <div class="bol-input-btn">
            <button type="button" onclick="BOL.buscarRuc()">Buscar</button>
            <input type="text" class="form-control" id="bolRuc" placeholder="RUC" />
          </div>
        </div>
        <div style="flex:2">
          <label>Razón social</label>
          <input type="text" class="form-control" id="bolRazonSocial" placeholder="Razón social (opcional, para factura)" />
        </div>
      </div>

      <!-- Acciones -->
      <div class="bol-venta-acciones">
        <button class="bol-btn-guardar-asiento" onclick="BOL.guardar()"><i data-lucide="save"></i> Guardar</button>
        <button class="bol-btn-anular-asiento" id="bolBtnAnular" onclick="BOL.accion('anular')"><i data-lucide="x-circle"></i> Anular</button>
        <button id="bolBtnPostergar" onclick="BOL.accion('postergar')"><i data-lucide="calendar-clock"></i> Postergar</button>
        <button class="bol-btn-habilitar-asiento" id="bolBtnHabilitar" onclick="BOL.abrirHabilitar()"><i data-lucide="power"></i> Habilitar</button>
        <button class="bol-btn-reintegro-asiento" id="bolBtnReintegro" onclick="BOL.abrirReintegro()"><i data-lucide="rotate-ccw"></i> Reintegro</button>
        <button class="bol-btn-reservar-asiento" id="bolBtnReservar" onclick="BOL.accion('reservar')"><i data-lucide="bookmark"></i> Reservar</button>
        <button onclick="BOL.imprimir()"><i data-lucide="printer"></i> Imprimir</button>
      </div>

    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════
     MODAL: Habilitar con serie/correlativo manual
     ═══════════════════════════════════════════════ -->
<div class="modal-backdrop" id="bolModalHabilitar" style="display:none">
  <div class="modal bol-modal-habilitar">
    <div class="modal-header">
      <div class="modal-title"><i data-lucide="power"></i> Habilitar asiento</div>
      <button class="modal-close" onclick="BOL.cerrarHabilitar()"><i data-lucide="x"></i></button>
    </div>
    <div class="modal-body">
      <p class="bol-habilitar-desc">
        Ingresa la serie y el correlativo del boleto o factura (por ejemplo, uno emitido
        fuera del sistema) para activarlo en el asiento seleccionado.
        Si ese número pertenece a un boleto postergado/reservado de <b>otra empresa</b>,
        se generará un boleto nuevo con la numeración de esta empresa y el original
        quedará marcado como usado.
      </p>
      <div class="bol-venta-row">
        <div>
          <label>Serie</label>
          <input type="text" class="form-control" id="bolHabSerie" placeholder="Ej: B001"
                 maxlength="10" oninput="this.value=this.value.toUpperCase()" />
        </div>
        <div>
          <label>Correlativo</label>
          <input type="number" class="form-control" id="bolHabCorrelativo" placeholder="Ej: 128" min="1" />
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="BOL.cerrarHabilitar()">Cancelar</button>
      <button class="btn btn-primary" onclick="BOL.confirmarHabilitar()">
        <i data-lucide="power"></i> Activar asiento
      </button>
    </div>
  </div>
</div>

<!-- ═══ MODAL: Reintegro ═══ -->
<div class="modal-backdrop" id="bolModalReintegro" style="display:none">
  <div class="modal bol-modal-reintegro">
    <div class="modal-header">
      <div class="modal-title"><i data-lucide="tag"></i> Reintegro</div>
      <button class="modal-close" onclick="BOL.cerrarReintegro()"><i data-lucide="x"></i></button>
    </div>
    <div class="modal-body">
      <p class="bol-habilitar-desc">Selecciona una opción para procesar el reintegro de tu boleto.</p>
      <p class="bol-reintegro-subtitulo">Para el boleto actual…</p>

      <label class="bol-reintegro-label">Boleto a procesar</label>
      <div class="bol-venta-row" style="align-items:flex-end">
        <div>
          <label>Serie</label>
          <input type="text" class="form-control" id="bolReSerie" placeholder="Serie"
                 maxlength="10" oninput="this.value=this.value.toUpperCase()" />
        </div>
        <div>
          <label>Correlativo</label>
          <input type="number" class="form-control" id="bolReCorrelativo" placeholder="Correlativo" min="1" />
        </div>
        <div>
          <button type="button" class="btn btn-ghost" onclick="BOL.buscarOrigenReintegro()">
            <i data-lucide="search"></i> Buscar
          </button>
        </div>
      </div>
      <div id="bolReOrigenPreview" class="bol-reintegro-preview" style="display:none"></div>

      <div class="bol-reintegro-opciones">
        <label class="bol-reintegro-opcion">
          <input type="radio" name="bolReTipo" value="1" checked onchange="BOL.cambiarTipoReintegro(1)" />
          <i data-lucide="tag"></i>
          <span>1.- Reintegro por Variación de Precio Pasaje (Cambio de Serv.)</span>
        </label>
        <label class="bol-reintegro-opcion">
          <input type="radio" name="bolReTipo" value="2" onchange="BOL.cambiarTipoReintegro(2)" />
          <i data-lucide="id-card"></i>
          <span>2.- Cambio de Nombre o Pérdida de Boleto</span>
        </label>
      </div>

      <div class="bol-venta-row">
        <div>
          <label>Precio del nuevo boleto (S/)</label>
          <input type="number" class="form-control" id="bolRePrecio" step="0.01" min="0" />
        </div>
        <div>
          <label>Método de pago</label>
          <select class="form-control" id="bolReMetodoPago">
            <option value="efectivo">Efectivo</option>
            <option value="tarjeta">Tarjeta</option>
            <option value="yape">Yape</option>
            <option value="plin">Plin</option>
            <option value="transferencia">Transferencia</option>
          </select>
        </div>
      </div>

      <p class="bol-reintegro-subtitulo">Agencias de esta salida</p>
      <div class="bol-venta-row">
        <div>
          <label>Agencia de Embarque</label>
          <select class="form-control" id="bolReAgenciaOrigen">
            <option value="">— Selecciona —</option>
          </select>
        </div>
        <div>
          <label>Agencia de Destino</label>
          <select class="form-control" id="bolReAgenciaDestino">
            <option value="">— Selecciona —</option>
          </select>
        </div>
      </div>

      <div id="bolReCambioNombre" style="display:none">
        <p class="bol-reintegro-subtitulo">Nuevos datos del pasajero</p>
        <div class="bol-venta-row">
          <div>
            <label>Tipo Documento</label>
            <select class="form-control" id="bolReTipoDoc">
              <option value="DNI">DNI</option>
              <option value="CE">Carné Ext.</option>
              <option value="Pasaporte">Pasaporte</option>
            </select>
          </div>
          <div>
            <label>Número Documento</label>
            <input type="text" class="form-control" id="bolReNumDoc" placeholder="00000000" />
          </div>
        </div>
        <label>Nombre completo</label>
        <input type="text" class="form-control" id="bolReNombre" placeholder="Nombre completo del nuevo pasajero" />
        <div class="bol-venta-row">
          <div>
            <label>Edad</label>
            <input type="number" class="form-control" id="bolReEdad" placeholder="Edad" min="0" />
          </div>
          <div>
            <label>Teléfono</label>
            <input type="text" class="form-control" id="bolReTelefono" placeholder="999 999 999" />
          </div>
        </div>
      </div>

      <p class="bol-reintegro-subtitulo">Factura (opcional)</p>
      <div class="bol-venta-row">
        <div>
          <label>RUC</label>
          <input type="text" class="form-control" id="bolReRuc" placeholder="RUC (opcional)" maxlength="11" />
        </div>
        <div>
          <label>Razón Social</label>
          <input type="text" class="form-control" id="bolReRazonSocial" placeholder="Razón social" />
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-danger" onclick="BOL.cerrarReintegro()"><i data-lucide="x"></i> Cancelar</button>
      <button class="btn btn-primary" onclick="BOL.confirmarReintegro()">
        <i data-lucide="check"></i> Aceptar
      </button>
    </div>
  </div>
</div>

<div class="ma-toast" id="bolToast"></div>

<!-- ═══════════════════════════════════════════════
     MODAL: Información General del Bus (Croquis / Manifiesto)
     ═══════════════════════════════════════════════ -->
<div class="modal-backdrop" id="bolModalTripulacion" style="display:none">
  <div class="modal bol-modal-tripulacion">
    <div class="modal-header">
      <div class="modal-title"><i data-lucide="search"></i> Información General del Bus</div>
      <button class="modal-close" onclick="BOL.cerrarTripulacion()"><i data-lucide="x"></i></button>
    </div>
    <div class="modal-body">
      <div class="trip-grid">
        <div class="trip-col">
          <div class="trip-field">
            <label>Propietario</label>
            <input type="text" class="form-control" id="tripPropietario" readonly />
          </div>
          <div class="trip-field">
            <label>Terramoza</label>
            <select class="form-control" id="tripTerramoza"><option value="">— Ninguna —</option></select>
          </div>
          <div class="trip-field">
            <label>Ayudante</label>
            <select class="form-control" id="tripAyudante"><option value="">— Ninguno —</option></select>
          </div>
          <div class="trip-field-row">
            <div class="trip-field">
              <label>Marca</label>
              <input type="text" class="form-control" id="tripMarca" readonly />
            </div>
            <div class="trip-field">
              <label>Servicio</label>
              <select class="form-control" id="tripServicio"><option value="">—</option></select>
            </div>
          </div>
          <div class="trip-field">
            <label>Piloto</label>
            <select class="form-control" id="tripPiloto"><option value="">— Ninguno —</option></select>
          </div>
          <div class="trip-field-row">
            <div class="trip-field">
              <label>Co-Piloto 1</label>
              <select class="form-control" id="tripCopiloto1"><option value="">— Ninguno —</option></select>
            </div>
            <div class="trip-field">
              <label>Co-Piloto 2</label>
              <select class="form-control" id="tripCopiloto2"><option value="">— Ninguno —</option></select>
            </div>
          </div>
        </div>
        <div class="trip-col trip-col-specs">
          <div class="trip-specs-titulo">Especificaciones y Registros</div>
          <div class="trip-field">
            <label>Tarj. Única Circulación</label>
            <input type="text" class="form-control" id="tripTarjeta" readonly />
          </div>
          <div class="trip-field">
            <label>Nro Asientos</label>
            <input type="text" class="form-control" id="tripNroAsientos" readonly />
          </div>
          <div class="trip-field">
            <label>Placa</label>
            <select class="form-control" id="tripPlaca"><option value="">— Selecciona bus —</option></select>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer trip-footer">
      <button class="btn btn-ghost" onclick="BOL.cerrarTripulacion()"><i data-lucide="x"></i> Cancelar</button>
      <button class="btn btn-primary" onclick="BOL.guardarTripulacion()"><i data-lucide="check"></i> Aceptar</button>
      <span class="trip-footer-spacer"></span>
      <button class="btn-icon trip-icon-btn" title="Imprimir" onclick="BOL.imprimirTripulacion()">
        <i data-lucide="printer"></i>
      </button>
      <button class="btn-icon trip-icon-btn" title="Control de embarque (asistencia)" id="tripBtnTablero" style="display:none" onclick="BOL.irAsistencia()">
        <i data-lucide="clipboard-check"></i>
      </button>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════
     MODAL: Editar precio / horario de una salida
     ═══════════════════════════════════════════════ -->
<div class="modal-backdrop" id="bolModalPrecio" style="display:none">
  <div class="modal bol-modal-habilitar">
    <div class="modal-header">
      <div class="modal-title"><i data-lucide="pencil"></i> Editar precio / horario</div>
      <button class="modal-close" onclick="BOL.cerrarEditarPrecio()"><i data-lucide="x"></i></button>
    </div>
    <div class="modal-body">
      <div class="bol-venta-row">
        <div>
          <label>Precio 1er Piso (S/.)</label>
          <input type="number" class="form-control" id="bolPrecioP1Edit" step="0.01" min="0" />
        </div>
        <div>
          <label>Precio 2do Piso (S/.)</label>
          <input type="number" class="form-control" id="bolPrecioP2Edit" step="0.01" min="0" />
        </div>
      </div>
      <div class="bol-venta-row">
        <div>
          <label>Hora de salida (primer paradero)</label>
          <input type="time" class="form-control" id="bolHoraEdit" />
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="BOL.cerrarEditarPrecio()">Cancelar</button>
      <button class="btn btn-primary" onclick="BOL.guardarEditarPrecio()">
        <i data-lucide="save"></i> Guardar cambios
      </button>
    </div>
  </div>
</div>

<script src="/js/comprobante-print.js"></script>
<script src="/js/croquis-manifiesto-print.js"></script>
<script>
// ═══════════════════════════════════════════════════
// BOL — Ventana de venta de asientos (Croquis)
// Reutiliza la construcción visual del bus del Mapa de Asientos
// ═══════════════════════════════════════════════════
var BOL = (function () {

  var progId       = null;
  var pisoActivo   = 1;
  var data         = null;               // respuesta completa de /croquis
  var boletosPorAsiento = {};            // "piso-numero" -> boleto
  var seleccion    = null;               // { piso, numero_asiento, precio }
  var codigoValidado = null;             // { codigo, monto } cuando se valida un código

  function toast(msg, tipo) {
    var el = document.getElementById('bolToast');
    el.textContent = msg;
    el.className = 'ma-toast ma-toast-' + (tipo || 'ok') + ' ma-toast-visible';
    setTimeout(function () { el.className = 'ma-toast'; }, 3000);
  }

  function get(url) { return fetch(url, { credentials: 'same-origin' }).then(function (r) { return r.json(); }); }
  function post(url, body) {
    return fetch(url, {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    }).then(function (r) { return r.json(); });
  }

  function iconoAsientoSVG() {
    return '<img src="/images/mapa-asientos/seat-icon.png" alt="" draggable="false" />';
  }

  // Ícono de persona (asiento ocupado) — silueta simple, se colorea con
  // currentColor para combinar con el color de la agencia que lo vendió.
  function iconoPersonaSVG() {
    return '<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">' +
      '<circle cx="12" cy="7.2" r="4.2"/>' +
      '<path d="M4 21c0-4.4 3.6-7.2 8-7.2s8 2.8 8 7.2v0.4a0.6 0.6 0 0 1-0.6 0.6H4.6a0.6 0.6 0 0 1-0.6-0.6V21Z"/>' +
      '</svg>';
  }

  function abrirCroquis(id) {
    progId = id;
    seleccion = null;
    get('/boletaje/' + id + '/croquis').then(function (res) {
      if (res.error) { toast('Error: ' + res.error, 'error'); return; }
      data = res;
      boletosPorAsiento = {};
      (data.boletos || []).forEach(function (b) {
        boletosPorAsiento[b.piso + '-' + b.numero_asiento] = b;
      });

      document.getElementById('bolRuta').textContent =
        (data.programacion.ciudad_origen || '—') + '  →  ' + (data.programacion.ciudad_destino || '—');
      document.getElementById('bolHora').textContent  = data.programacion.hora_primer_paradero || '—';
      document.getElementById('bolFecha').textContent = formatearFecha(data.programacion.fecha_salida);
      document.getElementById('bolUsuarioBadge').textContent = data.usuarioActual.nombre;

      llenarSelect('bolAgenciaOrigen',  data.agenciasOrigen);
      llenarSelect('bolAgenciaDestino', data.agenciasDestino);

      aplicarPermisos(data.permisos || {});

      var np = data.config ? data.config.num_pisos : 1;
      document.getElementById('bolTabs').style.display = '';
      document.getElementById('bolTab2').style.display = np >= 2 ? '' : 'none';
      document.getElementById('bolWarning').style.display = np >= 2 ? '' : 'none';

      renderPiso(1);
      renderPiso(2);
      cambiarTab(1);
      limpiarFormulario();

      document.getElementById('bolModalCroquis').style.display = 'flex';
      if (window.lucide) lucide.createIcons();
    }).catch(function () { toast('Error de conexión al cargar el croquis.', 'error'); });
  }

  function llenarSelect(id, opciones) {
    var sel = document.getElementById(id);
    sel.innerHTML = '<option value="">— Selecciona —</option>';
    (opciones || []).forEach(function (a) {
      var o = document.createElement('option');
      o.value = a.id; o.textContent = a.nombre;
      sel.appendChild(o);
    });
  }

  // ── Oculta/deshabilita los botones de acción según los permisos del usuario ──
  function aplicarPermisos(permisos) {
    var mapa = { bolBtnAnular: 'puede_anular', bolBtnPostergar: 'puede_postergar', bolBtnReservar: 'puede_reservar', bolBtnHabilitar: 'puede_habilitar', bolBtnReintegro: 'puede_reintegro' };
    Object.keys(mapa).forEach(function (btnId) {
      var btn = document.getElementById(btnId);
      var permitido = permisos[mapa[btnId]] !== false;
      btn.disabled = !permitido;
      btn.classList.toggle('bol-btn-disabled', !permitido);
      btn.title = permitido ? '' : 'No tienes permiso para realizar esta acción.';
      btn.dataset.sinPermiso = permitido ? '0' : '1';
    });
  }

  function formatearFecha(iso) {
    if (!iso) return '—';
    var p = iso.split('-');
    if (p.length !== 3) return iso;
    return p[2] + '/' + p[1] + '/' + p[0];
  }

  // ── Dibuja un piso del bus con los estados de venta ──
  function renderPiso(piso) {
    var wrap = document.getElementById('bolFilasP' + piso);
    var frame = document.getElementById('bolFrameP' + piso);
    if (!wrap || !data || !data.config) return;

    var filas   = piso === 1 ? data.config.filas_p1    : data.config.filas_p2;
    var cols    = piso === 1 ? data.config.columnas_p1 : data.config.columnas_p2;
    var pasillo = piso === 1 ? data.config.pasillo_p1  : data.config.pasillo_p2;
    wrap.innerHTML = '';
    if (!filas || !cols) { if (frame) frame.style.height = '0px'; return; }

    // Matriz piso -> fila -> col -> asiento{numero,tipo}
    var celdas = {};
    (data.asientos || []).filter(function (a) { return a.piso === piso; }).forEach(function (a) {
      celdas[a.fila + '-' + a.columna] = a;
    });

    for (var f = 1; f <= filas; f++) {
      var filaEl = document.createElement('div');
      filaEl.className = 'ma-fila-row';
      var badge = document.createElement('span');
      badge.className = 'ma-fila-badge'; badge.textContent = f;
      filaEl.appendChild(badge);

      for (var c = 1; c <= cols; c++) {
        var asiento = celdas[f + '-' + c];
        var celda = document.createElement('div');

        if (!asiento) {
          celda.className = 'ma-asiento bol-noclick';
          celda.style.visibility = 'hidden';
          filaEl.appendChild(celda);
          continue;
        }

        if (asiento.tipo === 'escalera') {
          celda.className = 'ma-asiento ma-asiento-escalera bol-noclick';
          var img = document.createElement('img');
          img.src = '/images/mapa-asientos/escalera.png'; img.className = 'ma-escalera-img'; img.alt = 'Escalera';
          celda.appendChild(img);
          filaEl.appendChild(celda);
          continue;
        }

        var key = piso + '-' + asiento.numero_asiento;
        var boleto = boletosPorAsiento[key];
        var estado = boleto ? boleto.estado : 'libre';
        var claseEstado = { libre: 'bol-libre', vendido: 'bol-vendido', reservado: 'bol-reservado', postergado: 'bol-postergado', reintegro: 'bol-reintegro' }[estado] || 'bol-libre';

        celda.className = 'ma-asiento ' + claseEstado;
        // El "transferido de otra empresa" solo se pinta de negro
        // mientras esté VENDIDO activamente. Si ese mismo boleto
        // luego se postergó o anuló, debe verse como cualquier otro
        // postergado/anulado — si no, el negro (con la opacidad del
        // estado) se veía como un gris confuso, y parecía "libre".
        if (boleto && boleto.transferido_otra_empresa && boleto.estado === 'vendido') {
          celda.className += ' bol-transferido';
        }
        if (seleccion && seleccion.piso === piso && seleccion.numero_asiento === asiento.numero_asiento) {
          celda.className += ' bol-seleccionado';
        }
        celda.dataset.piso = piso; celda.dataset.numero = asiento.numero_asiento;

        var agenciaVendedor = boleto && boleto.vendedor ? boleto.vendedor.agencia : null;
        if (estado === 'vendido' && agenciaVendedor && agenciaVendedor.color) {
          celda.style.setProperty('--bol-agencia-color', agenciaVendedor.color);
          celda.classList.add('bol-color-agencia');
        }

        var tituloPartes = ['Asiento ' + asiento.numero_asiento];
        if (boleto && boleto.nombre_completo) tituloPartes.push(boleto.nombre_completo);
        if (boleto && boleto.vendedor) {
          tituloPartes.push('Vendido por: ' + boleto.vendedor.nombre + (agenciaVendedor ? ' (' + agenciaVendedor.nombre + ')' : ''));
        }
        celda.title = tituloPartes.join(' — ');
        celda.onclick = function () { seleccionarAsiento(this.dataset.piso, this.dataset.numero); };

        var ico = document.createElement('div');
        ico.className = 'ma-asiento-ico';
        ico.innerHTML = (estado === 'vendido' || estado === 'reintegro') ? iconoPersonaSVG() : iconoAsientoSVG();
        var num = document.createElement('div');
        num.className = 'ma-asiento-num';
        num.style.cursor = 'pointer';
        num.textContent = asiento.numero_asiento;

        celda.appendChild(ico);
        celda.appendChild(num);
        filaEl.appendChild(celda);
      }
      wrap.appendChild(filaEl);

      if (pasillo && f === pasillo && f < filas) {
        var pas = document.createElement('div');
        pas.className = 'ma-pasillo';
        pas.innerHTML = '<span>PASILLO</span>';
        wrap.appendChild(pas);
      }
    }

    // Reutiliza la misma fórmula de alto que el editor del Mapa de Asientos
    var tienePasillo = pasillo && pasillo < filas;
    var CELL_H = 38, ROW_GAP = 6, PASILLO_H = 22, PAD_V = 32;
    var alto = filas * CELL_H + (filas - 1) * ROW_GAP + (tienePasillo ? (PASILLO_H + ROW_GAP) : 0) + PAD_V;
    var NOSE_RATIO = 375 / 603, TAIL_RATIO = 548 / 603;
    frame.style.height = alto + 'px';
    frame.style.borderLeftWidth  = Math.round(alto * NOSE_RATIO) + 'px';
    frame.style.borderRightWidth = Math.round(alto * TAIL_RATIO) + 'px';

    actualizarLeyendaAgencias();
  }

  // ── Construye la leyenda de colores por agencia, según lo vendido en este viaje ──
  function actualizarLeyendaAgencias() {
    var cont = document.getElementById('bolLeyendaAgencias');
    var vistas = {};
    var items = [];
    Object.keys(boletosPorAsiento).forEach(function (key) {
      var b = boletosPorAsiento[key];
      if (b.estado !== 'vendido' || !b.vendedor || !b.vendedor.agencia) return;
      var ag = b.vendedor.agencia;
      if (vistas[ag.id]) return;
      vistas[ag.id] = true;
      items.push(ag);
    });
    if (items.length === 0) { cont.style.display = 'none'; cont.innerHTML = ''; return; }
    cont.style.display = '';
    cont.innerHTML = '<span class="bol-leyenda-titulo">Vendido por agencia:</span>' + items.map(function (ag) {
      return '<span class="bol-leyenda-item"><i class="bol-dot" style="background:' + (ag.color || '#94a3b8') + '"></i>' + ag.nombre + '</span>';
    }).join('');
  }

  function cambiarTab(piso) {
    pisoActivo = piso;
    document.getElementById('bolVistaPiso1').style.display = piso === 1 ? '' : 'none';
    document.getElementById('bolVistaPiso2').style.display = piso === 2 ? '' : 'none';
    document.getElementById('bolTab1').className = 'ma-tab' + (piso === 1 ? ' ma-tab-active' : '');
    document.getElementById('bolTab2').className = 'ma-tab' + (piso === 2 ? ' ma-tab-active' : '');
  }

  // ── Selecciona un asiento: carga su boleto o deja el formulario libre ──
  function seleccionarAsiento(piso, numero) {
    piso = parseInt(piso);
    seleccion = { piso: piso, numero_asiento: numero };
    codigoValidado = null;
    document.getElementById('bolCodigo').value = '';
    document.getElementById('bolCodigoHint').textContent = '';
    renderPiso(1); renderPiso(2);

    var precio = piso === 1 ? data.programacion.precio_piso1 : data.programacion.precio_piso2;
    document.getElementById('bolSeleccionPanel').style.display = '';
    document.getElementById('bolAsientoSel').textContent = 'Asiento ' + numero;
    document.getElementById('bolPrecioSel').textContent  = 'S/ ' + (precio != null ? Number(precio).toFixed(2) : '0.00');
    document.getElementById('bolPisoSel').textContent    = 'Piso ' + piso;

    var boleto = boletosPorAsiento[piso + '-' + numero];
    var serieEl = document.getElementById('bolSerieSel');
    var serieBox = document.getElementById('bolSerieBox');
    if (boleto && boleto.serie && boleto.correlativo) {
      serieEl.textContent = boleto.serie + '-' + String(boleto.correlativo).padStart(8, '0');
      serieBox.classList.add('bol-serie-emitida');
    } else {
      serieEl.textContent = 'Sin emitir todavía — se generará al Guardar la venta';
      serieBox.classList.remove('bol-serie-emitida');
    }

    if (boleto) {
      document.getElementById('bolTipoDoc').value      = boleto.tipo_documento   || 'DNI';
      document.getElementById('bolNumDoc').value       = boleto.numero_documento || '';
      document.getElementById('bolNombre').value       = boleto.nombre_completo  || '';
      document.getElementById('bolEdad').value         = boleto.edad != null ? boleto.edad : '';
      document.getElementById('bolTelefono').value     = boleto.telefono || '';
      document.getElementById('bolRuc').value          = boleto.ruc || '';
      document.getElementById('bolRazonSocial').value  = boleto.razon_social || '';
      document.getElementById('bolAgenciaOrigen').value  = boleto.agencia_embarque_id || '';
      document.getElementById('bolAgenciaDestino').value = boleto.agencia_llegada_id  || '';
      // Por defecto siempre "Venta": así, si ya está reservado y el
      // cajero completa los datos y presiona Guardar, el asiento pasa
      // de reservado a vendido directamente. Si de verdad quiere
      // volver a reservarlo, para eso está el botón "Reservar".
      document.getElementById('bolTipoMov').value = 'venta';
      document.getElementById('bolMetodoPago').value = boleto.metodo_pago || 'efectivo';
      if (boleto.codigo_usado) {
        document.getElementById('bolCodigo').value = boleto.codigo_usado;
        document.getElementById('bolCodigoHint').textContent = 'Código aplicado en esta venta.';
      }
      if (boleto.precio != null) {
        document.getElementById('bolPrecioSel').textContent = 'S/ ' + Number(boleto.precio).toFixed(2);
      }
      // El asiento está ocupado: el "usuario" muestra quién lo vendió (y su agencia)
      var nombreVendedor = (boleto.vendedor && boleto.vendedor.nombre) ? boleto.vendedor.nombre : 'Desconocido';
      var agenciaVendedorTxt = (boleto.vendedor && boleto.vendedor.agencia) ? ' — ' + boleto.vendedor.agencia.nombre : '';
      document.getElementById('bolUsuarioBadge').textContent = nombreVendedor + agenciaVendedorTxt;
    } else {
      limpiarFormularioCliente();
      // Asiento libre: el "usuario" vuelve a mostrar quién está haciendo la venta ahora
      document.getElementById('bolUsuarioBadge').textContent = data.usuarioActual.nombre;
    }

    aplicarEstadoBotones(boleto ? boleto.estado : 'libre');

    // Una vez que el asiento tiene un boleto activo, los datos de
    // identidad del pasajero ya NO se pueden editar aquí — para
    // corregir nombre/DNI/edad/teléfono/RUC/Razón Social existe la
    // función Reintegro (que emite un comprobante nuevo, trazable).
    var bloqueado = !!boleto;
    ['bolTipoDoc', 'bolNumDoc', 'bolNombre', 'bolEdad', 'bolTelefono', 'bolRuc', 'bolRazonSocial'].forEach(function (id) {
      var el = document.getElementById(id);
      if (!el) return;
      if (el.tagName === 'SELECT') el.disabled = bloqueado;
      else el.readOnly = bloqueado;
      el.classList.toggle('bol-campo-bloqueado', bloqueado);
      el.title = bloqueado ? 'Ya no se puede editar: usa Reintegro para corregir estos datos.' : '';
    });
  }

  // ── Además de los permisos, cada acción solo tiene sentido en
  // ciertos estados del asiento: no se puede postergar/anular un
  // asiento libre, ni reservar uno ya ocupado. ──
  function aplicarEstadoBotones(estado) {
    var reglas = {
      bolBtnPostergar: estado === 'vendido' || estado === 'reintegro',
      bolBtnAnular:    estado === 'vendido' || estado === 'reservado' || estado === 'postergado' || estado === 'reintegro',
      bolBtnReservar:  estado === 'libre',
      // Habilitar y Reintegro solo tienen sentido sobre un asiento
      // libre: si ya está ocupado (vendido/reservado/reintegro), no
      // corresponde activar otro boleto encima — primero hay que
      // anularlo.
      bolBtnHabilitar: estado === 'libre',
      bolBtnReintegro: estado === 'libre'
    };
    Object.keys(reglas).forEach(function (btnId) {
      var btn = document.getElementById(btnId);
      if (!btn || btn.dataset.sinPermiso === '1') return; // ya deshabilitado por permisos, no lo pisamos
      var permitidoPorEstado = reglas[btnId];
      btn.disabled = !permitidoPorEstado;
      btn.classList.toggle('bol-btn-disabled', !permitidoPorEstado);
      if (!permitidoPorEstado) btn.title = 'No aplica para un asiento en estado "' + estado + '".';
      else btn.title = '';
    });
  }

  function limpiarFormularioCliente() {
    ['bolNumDoc','bolNombre','bolEdad','bolTelefono','bolRuc','bolRazonSocial'].forEach(function (id) {
      document.getElementById(id).value = '';
    });
    document.getElementById('bolTipoDoc').value = 'DNI';
    document.getElementById('bolTipoMov').value = 'venta';
    document.getElementById('bolMetodoPago').value = 'efectivo';
  }

  function limpiarFormulario() {
    limpiarFormularioCliente();
    document.getElementById('bolAgenciaOrigen').value  = '';
    document.getElementById('bolAgenciaDestino').value = '';
    document.getElementById('bolCodigo').value = '';
    document.getElementById('bolSeleccionPanel').style.display = 'none';
    document.getElementById('bolSerieSel').textContent = 'Selecciona un asiento para ver su número de boleto';
    document.getElementById('bolSerieBox').classList.remove('bol-serie-emitida');
  }

  function datosFormulario() {
    var precioBase = seleccion.piso === 1 ? data.programacion.precio_piso1 : data.programacion.precio_piso2;
    var precio = codigoValidado ? codigoValidado.monto : precioBase;
    return {
      piso: seleccion.piso,
      numero_asiento: seleccion.numero_asiento,
      precio: precio,
      tipo_documento:   document.getElementById('bolTipoDoc').value,
      numero_documento: document.getElementById('bolNumDoc').value,
      nombre_completo:  document.getElementById('bolNombre').value,
      edad:             document.getElementById('bolEdad').value,
      telefono:         document.getElementById('bolTelefono').value,
      ruc:              document.getElementById('bolRuc').value,
      razon_social:     document.getElementById('bolRazonSocial').value,
      agencia_embarque_id: document.getElementById('bolAgenciaOrigen').value,
      agencia_llegada_id:  document.getElementById('bolAgenciaDestino').value,
      metodo_pago:          document.getElementById('bolMetodoPago').value,
      codigo_usado:         codigoValidado ? codigoValidado.codigo : null
    };
  }

  // ── Valida un código de autorización y, si es válido, cambia el precio ──
  function validarCodigo() {
    var input = document.getElementById('bolCodigo');
    var hint  = document.getElementById('bolCodigoHint');
    var codigo = input.value.trim();
    if (!codigo) {
      codigoValidado = null;
      hint.textContent = '';
      actualizarPrecioMostrado();
      return;
    }
    get('/codigos/validar/' + encodeURIComponent(codigo)).then(function (r) {
      if (r.ok) {
        codigoValidado = { codigo: r.codigo, monto: r.monto };
        hint.textContent = 'Código válido' + (r.descripcion ? ' — ' + r.descripcion : '') + '. Precio: S/ ' + Number(r.monto).toFixed(2);
        hint.className = 'bol-codigo-hint bol-codigo-ok';
        actualizarPrecioMostrado();
        toast('Código aplicado. Nuevo precio: S/ ' + Number(r.monto).toFixed(2), 'ok');
      } else {
        codigoValidado = null;
        hint.textContent = r.error || 'Código no válido.';
        hint.className = 'bol-codigo-hint bol-codigo-error';
        actualizarPrecioMostrado();
      }
    }).catch(function () {
      hint.textContent = 'Error al validar el código.';
      hint.className = 'bol-codigo-hint bol-codigo-error';
    });
  }

  function actualizarPrecioMostrado() {
    if (!seleccion) return;
    var precioBase = seleccion.piso === 1 ? data.programacion.precio_piso1 : data.programacion.precio_piso2;
    var precio = codigoValidado ? codigoValidado.monto : precioBase;
    document.getElementById('bolPrecioSel').textContent = 'S/ ' + Number(precio || 0).toFixed(2);
  }

  function requiereSeleccion() {
    if (!seleccion) { toast('Selecciona primero un asiento en el croquis.', 'error'); return false; }
    return true;
  }

  function guardar() {
    if (!requiereSeleccion()) return;
    if (!confirm('¿Estás seguro de realizar esta venta?')) return;
    var tipoMov = document.getElementById('bolTipoMov').value;
    var body = datosFormulario();
    body.accion = tipoMov === 'reserva' ? 'reservar' : 'guardar';
    post('/boletaje/' + progId + '/asiento', body).then(function (r) {
      if (r.ok) {
        var msg = 'Asiento guardado correctamente.';
        if (r.serie && r.correlativo) msg += ' Boleto N° ' + r.serie + '-' + String(r.correlativo).padStart(8, '0');
        toast(msg, 'ok');
        var esVentaReal = body.accion === 'guardar';
        recargar().then(function () {
          if (esVentaReal) imprimirComprobante(r.serie, r.correlativo, body.precio);
        });
      } else toast('Error: ' + (r.error || ''), 'error');
    });
  }

  function accion(tipo) {
    if (!requiereSeleccion()) return;
    var mensajes = { anular: '¿Estás seguro de realizar esta anulación?', postergar: '¿Estás seguro de realizar esta postergación?' };
    if (mensajes[tipo] && !confirm(mensajes[tipo])) return;
    var body = datosFormulario();
    body.accion = tipo;
    post('/boletaje/' + progId + '/asiento', body).then(function (r) {
      if (r.ok) {
        var msgs = { anular: 'Asiento anulado.', postergar: 'Asiento postergado.', reservar: 'Asiento reservado.' };
        toast(msgs[tipo] || 'Listo.', 'ok');
        recargar();
      } else toast('Error: ' + (r.error || ''), 'error');
    });
  }

  // ── Habilitar con serie/correlativo manual ──
  function abrirHabilitar() {
    if (!requiereSeleccion()) return;
    document.getElementById('bolHabSerie').value = '';
    document.getElementById('bolHabCorrelativo').value = '';
    document.getElementById('bolModalHabilitar').style.display = 'flex';
  }
  function cerrarHabilitar() {
    document.getElementById('bolModalHabilitar').style.display = 'none';
  }
  function confirmarHabilitar() {
    var serie = document.getElementById('bolHabSerie').value.trim();
    var correlativo = document.getElementById('bolHabCorrelativo').value.trim();
    if (!serie || !correlativo) { toast('Ingresa la serie y el correlativo.', 'error'); return; }
    var body = datosFormulario();
    body.accion = 'habilitar';
    body.serie_manual = serie;
    body.correlativo_manual = correlativo;
    post('/boletaje/' + progId + '/asiento', body).then(function (r) {
      if (r.ok) {
        var num = r.serie + '-' + String(r.correlativo).padStart(8, '0');
        if (r.transferido) {
          toast('Boleto original de otra empresa: se generó el nuevo comprobante ' + num + ' y el original quedó "usado".', 'ok');
        } else {
          toast('Asiento habilitado con boleto ' + num + '.', 'ok');
        }
        cerrarHabilitar();
        recargar();
      } else toast('Error: ' + (r.error || ''), 'error');
    });
  }

  function recargar() {
    var sel = seleccion;
    return get('/boletaje/' + progId + '/croquis').then(function (res) {
      if (res.error) return;
      data = res;
      boletosPorAsiento = {};
      (data.boletos || []).forEach(function (b) { boletosPorAsiento[b.piso + '-' + b.numero_asiento] = b; });
      seleccion = sel;
      renderPiso(1); renderPiso(2);
      if (sel) seleccionarAsiento(sel.piso, sel.numero_asiento);
    });
  }

  // ── Editar precio / horario de una salida (solo autorizados) ──
  var progIdEditandoPrecio = null;
  function abrirEditarPrecio(id, precio1, precio2, hora) {
    progIdEditandoPrecio = id;
    document.getElementById('bolPrecioP1Edit').value = precio1 || '';
    document.getElementById('bolPrecioP2Edit').value = precio2 || '';
    document.getElementById('bolHoraEdit').value = (hora || '').slice(0, 5);
    document.getElementById('bolModalPrecio').style.display = 'flex';
  }
  function cerrarEditarPrecio() {
    document.getElementById('bolModalPrecio').style.display = 'none';
    progIdEditandoPrecio = null;
  }
  function guardarEditarPrecio() {
    if (!progIdEditandoPrecio) return;
    var body = {
      precio_piso1: document.getElementById('bolPrecioP1Edit').value,
      precio_piso2: document.getElementById('bolPrecioP2Edit').value,
      hora:         document.getElementById('bolHoraEdit').value
    };
    post('/boletaje/' + progIdEditandoPrecio + '/editar-precio', body).then(function (r) {
      if (r.ok) {
        toast('Precio y horario actualizados. Recarga la página para verlos reflejados.', 'ok');
        cerrarEditarPrecio();
        setTimeout(function () { window.location.reload(); }, 900);
      } else {
        toast('Error: ' + (r.error || ''), 'error');
      }
    }).catch(function () { toast('Error de conexión.', 'error'); });
  }

  function buscarDni() { toast('Búsqueda por DNI aún no está configurada.', 'error'); }
  function buscarRuc() { toast('Búsqueda por RUC aún no está configurada.', 'error'); }

  // ── Imprime el comprobante usando el generador ÚNICO y compartido
  // (public/js/comprobante-print.js) — el mismo que usa Comprobantes
  // al reimprimir, así el diseño nunca se desincroniza entre pantallas. ──
  function imprimirComprobante(serieForzada, correlativoForzado, precioForzado) {
    if (!seleccion) { toast('Selecciona un asiento para imprimir su comprobante.', 'error'); return; }
    var boleto = boletosPorAsiento[seleccion.piso + '-' + seleccion.numero_asiento] || {};
    var serie       = serieForzada       || boleto.serie;
    var correlativo = correlativoForzado || boleto.correlativo;
    var precio = precioForzado != null ? precioForzado : (boleto.precio != null ? boleto.precio : (seleccion.piso === 1 ? data.programacion.precio_piso1 : data.programacion.precio_piso2));

    var ruc = document.getElementById('bolRuc').value.trim();
    var razonSocial = document.getElementById('bolRazonSocial').value.trim();
    var agenciaId = document.getElementById('bolAgenciaOrigen').value;
    var agencia = (data.agenciasOrigen || []).find(function (a) { return String(a.id) === String(agenciaId); });
    var usuarioTxt = (boleto.vendedor && boleto.vendedor.username) ? boleto.vendedor.username : (data.usuarioActual.username || data.usuarioActual.nombre);

    ComprobantePrint.imprimir({
      serie: serie, correlativo: correlativo,
      ruc: ruc, razonSocial: razonSocial,
      empresa: data.bus && data.bus.empresa ? data.bus.empresa : null,
      agenciaEmbarqueNombre: agencia ? agencia.nombre : null,
      agenciaEmbarqueDireccion: agencia ? agencia.direccion : null,
      fechaSalida: data.programacion.fecha_salida,
      horaSalida: data.programacion.hora_primer_paradero,
      ciudadOrigen: data.programacion.ciudad_origen,
      ciudadDestino: data.programacion.ciudad_destino,
      servicio: data.programacion.servicio,
      precio: precio,
      numeroAsiento: seleccion.numero_asiento,
      piso: seleccion.piso,
      pax: document.getElementById('bolNombre').value || '—',
      tipoDocumento: document.getElementById('bolTipoDoc').value,
      numeroDocumento: document.getElementById('bolNumDoc').value,
      usuario: usuarioTxt,
      polizaBus: data.bus && data.bus.poliza,
      anulado: false
    });
  }

  function imprimir() { imprimirComprobante(); }

  function cerrar() {
    document.getElementById('bolModalCroquis').style.display = 'none';
    seleccion = null;
  }

  // ═══════════════════════════════════════════════
  // Información General del Bus (Croquis / Manifiesto)
  // Cualquier usuario puede abrir esto y editar la tripulación.
  // ═══════════════════════════════════════════════
  var tripProgId = null;
  var tripModo   = 'croquis';
  var tripDataActual = null;

  function abrirTripulacion(progIdParam, modo) {
    tripProgId = progIdParam;
    tripModo = modo || 'croquis';
    document.getElementById('tripBtnTablero').style.display = (tripModo === 'croquis') ? '' : 'none';

    get('/boletaje/' + tripProgId + '/tripulacion').then(function (res) {
      if (res.error) { toast('Error: ' + res.error, 'error'); return; }
      tripDataActual = res;

      llenarSelectPersonal('tripTerramoza', res.terramozas, res.prog.terramoza_id);
      llenarSelectPersonal('tripAyudante',  res.ayudantes,  res.prog.ayudante_id);
      llenarSelectPersonal('tripPiloto',    res.choferes,   res.prog.piloto_id);
      llenarSelectPersonal('tripCopiloto1', res.choferes,   res.prog.copiloto1_id);
      llenarSelectPersonal('tripCopiloto2', res.choferes,   res.prog.copiloto2_id);

      var selServicio = document.getElementById('tripServicio');
      selServicio.innerHTML = '<option value="">—</option>';
      (res.servicios || []).forEach(function (s) {
        var o = document.createElement('option');
        o.value = s.id; o.textContent = s.nombre;
        if (s.id === res.prog.servicio_id) o.selected = true;
        selServicio.appendChild(o);
      });

      var selPlaca = document.getElementById('tripPlaca');
      selPlaca.innerHTML = '<option value="">— Selecciona bus —</option>';
      (res.buses || []).forEach(function (b) {
        var o = document.createElement('option');
        o.value = b.id; o.textContent = b.placa;
        o.dataset.marca = b.marca || '';
        o.dataset.tarjeta = b.soat_poliza || '';
        o.dataset.asientos = b.total_asientos || '';
        o.dataset.propietario = b.empresas ? b.empresas.razon_social : '';
        if (b.id === res.prog.bus_id) o.selected = true;
        selPlaca.appendChild(o);
      });
      selPlaca.onchange = actualizarDatosBus;
      actualizarDatosBus();

      document.getElementById('bolModalTripulacion').style.display = 'flex';
      if (window.lucide) lucide.createIcons();
    }).catch(function () { toast('Error de conexión al cargar la tripulación.', 'error'); });
  }

  function llenarSelectPersonal(id, lista, seleccionadoId) {
    var sel = document.getElementById(id);
    sel.innerHTML = '<option value="">— Ninguno —</option>';
    (lista || []).forEach(function (p) {
      var o = document.createElement('option');
      o.value = p.id; o.textContent = p.nombres + ' ' + p.apellidos;
      if (p.id === seleccionadoId) o.selected = true;
      sel.appendChild(o);
    });
  }

  function actualizarDatosBus() {
    var sel = document.getElementById('tripPlaca');
    var op = sel.options[sel.selectedIndex];
    var marca = (op && op.dataset.marca) || '';
    var tarjeta = (op && op.dataset.tarjeta) || '';
    var asientos = (op && op.dataset.asientos) || '';
    var propietario = (op && op.dataset.propietario) || '';
    document.getElementById('tripMarca').value = marca;
    document.getElementById('tripTarjeta').value = tarjeta;
    document.getElementById('tripNroAsientos').value = asientos;
    document.getElementById('tripPropietario').value = propietario;
  }

  function cerrarTripulacion() {
    document.getElementById('bolModalTripulacion').style.display = 'none';
  }

  function guardarTripulacion() {
    if (!tripProgId) return;
    post('/boletaje/' + tripProgId + '/tripulacion', {
      bus_id:       document.getElementById('tripPlaca').value,
      servicio_id:  document.getElementById('tripServicio').value,
      piloto_id:    document.getElementById('tripPiloto').value,
      copiloto1_id: document.getElementById('tripCopiloto1').value,
      copiloto2_id: document.getElementById('tripCopiloto2').value,
      terramoza_id: document.getElementById('tripTerramoza').value,
      ayudante_id:  document.getElementById('tripAyudante').value
    }).then(function (r) {
      if (r.ok) { toast('Información del bus actualizada.', 'ok'); cerrarTripulacion(); }
      else toast('Error: ' + (r.error || ''), 'error');
    }).catch(function () { toast('Error de conexión.', 'error'); });
  }

  function imprimirTripulacion() {
    if (!tripProgId) return;
    var endpoint = tripModo === 'manifiesto' ? 'manifiesto-datos' : 'croquis-datos';
    get('/boletaje/' + tripProgId + '/' + endpoint).then(function (res) {
      if (res.error) { toast('Error: ' + res.error, 'error'); return; }
      if (tripModo === 'manifiesto') CroquisManifiestoPrint.imprimirManifiesto(res);
      else CroquisManifiestoPrint.imprimirCroquis(res);
    }).catch(function () { toast('Error de conexión al generar la impresión.', 'error'); });
  }

  function irAsistencia() {
    if (!tripProgId) return;
    window.open('/boletaje/' + tripProgId + '/asistencia', '_blank');
  }

  // ── Reintegro: emite un boleto nuevo a partir de uno original
  // (postergado/reservado) por variación de precio o cambio de nombre ──
  var reintegroOrigen = null;

  function abrirReintegro() {
    if (!requiereSeleccion()) return;
    document.getElementById('bolReSerie').value = '';
    document.getElementById('bolReCorrelativo').value = '';
    document.querySelector('input[name="bolReTipo"][value="1"]').checked = true;
    document.getElementById('bolReTipoDoc').value = 'DNI';
    document.getElementById('bolReNumDoc').value = '';
    document.getElementById('bolReNombre').value = '';
    document.getElementById('bolReEdad').value = '';
    document.getElementById('bolReTelefono').value = '';
    document.getElementById('bolReRuc').value = '';
    document.getElementById('bolReRazonSocial').value = '';
    document.getElementById('bolReMetodoPago').value = 'efectivo';
    document.getElementById('bolReOrigenPreview').style.display = 'none';
    reintegroOrigen = null;

    // Las agencias de esta salida son las mismas que ofrece el
    // formulario principal (data.agenciasOrigen / agenciasDestino)
    var selOrigen = document.getElementById('bolReAgenciaOrigen');
    var selDestino = document.getElementById('bolReAgenciaDestino');
    selOrigen.innerHTML = '<option value="">— Selecciona —</option>' +
      (data.agenciasOrigen || []).map(function (a) { return '<option value="' + a.id + '">' + a.nombre + '</option>'; }).join('');
    selDestino.innerHTML = '<option value="">— Selecciona —</option>' +
      (data.agenciasDestino || []).map(function (a) { return '<option value="' + a.id + '">' + a.nombre + '</option>'; }).join('');

    var precioBase = seleccion.piso === 1 ? data.programacion.precio_piso1 : data.programacion.precio_piso2;
    document.getElementById('bolRePrecio').value = precioBase != null ? Number(precioBase).toFixed(2) : '';
    cambiarTipoReintegro(1);
    document.getElementById('bolModalReintegro').style.display = 'flex';
  }
  function cerrarReintegro() {
    document.getElementById('bolModalReintegro').style.display = 'none';
  }
  function cambiarTipoReintegro(tipo) {
    document.getElementById('bolReCambioNombre').style.display = (tipo === 2) ? '' : 'none';
  }

  // Busca el boleto original por serie/correlativo: muestra una vista
  // previa, y precarga (sin obligar) las agencias de embarque/destino
  // si coinciden con alguna disponible en esta salida, y los datos
  // del pasajero para el caso de cambio de nombre (quedan editables).
  function buscarOrigenReintegro() {
    var serie = document.getElementById('bolReSerie').value.trim();
    var correlativo = document.getElementById('bolReCorrelativo').value.trim();
    if (!serie || !correlativo) { toast('Ingresa la serie y el correlativo del boleto a procesar.', 'error'); return; }

    get('/boletaje/' + progId + '/origen-reintegro?serie=' + encodeURIComponent(serie) + '&correlativo=' + encodeURIComponent(correlativo))
      .then(function (r) {
        if (r.error) {
          toast(r.error, 'error');
          document.getElementById('bolReOrigenPreview').style.display = 'none';
          reintegroOrigen = null;
          return;
        }
        reintegroOrigen = r;
        var preview = document.getElementById('bolReOrigenPreview');
        preview.style.display = '';
        preview.innerHTML = '<i data-lucide="check-circle-2"></i> Boleto encontrado: <b>' + (r.nombre_completo || '—') +
          '</b> — ' + (r.tipo_documento || 'DNI') + ' ' + (r.numero_documento || '—') +
          ' <span class="bol-reintegro-preview-estado">(' + r.estado + ')</span>';
        if (window.lucide) lucide.createIcons();

        // Precarga agencias si coinciden con alguna de esta salida (el usuario las puede cambiar)
        if (r.agencia_embarque_id) document.getElementById('bolReAgenciaOrigen').value = r.agencia_embarque_id;
        if (r.agencia_llegada_id)  document.getElementById('bolReAgenciaDestino').value = r.agencia_llegada_id;

        // Precarga datos del pasajero para cambio de nombre (editable)
        document.getElementById('bolReTipoDoc').value = r.tipo_documento || 'DNI';
        document.getElementById('bolReNumDoc').value  = r.numero_documento || '';
        document.getElementById('bolReNombre').value  = r.nombre_completo || '';
        document.getElementById('bolReEdad').value    = r.edad != null ? r.edad : '';
        document.getElementById('bolReTelefono').value = r.telefono || '';
        document.getElementById('bolReRuc').value        = r.ruc || '';
        document.getElementById('bolReRazonSocial').value = r.razon_social || '';
      }).catch(function () { toast('Error de conexión al buscar el boleto.', 'error'); });
  }

  function confirmarReintegro() {
    var serie = document.getElementById('bolReSerie').value.trim();
    var correlativo = document.getElementById('bolReCorrelativo').value.trim();
    if (!serie || !correlativo) { toast('Ingresa la serie y el correlativo del boleto a procesar.', 'error'); return; }
    var tipoSeleccionado = document.querySelector('input[name="bolReTipo"]:checked');
    var tipo = tipoSeleccionado ? parseInt(tipoSeleccionado.value) : 1;
    var precio = document.getElementById('bolRePrecio').value;
    if (precio === '' || isNaN(Number(precio))) { toast('Ingresa el precio del nuevo boleto.', 'error'); return; }

    var body = {
      piso: seleccion.piso,
      numero_asiento: seleccion.numero_asiento,
      accion: 'reintegro',
      serie_original: serie,
      correlativo_original: correlativo,
      tipo_reintegro: tipo,
      precio: precio,
      metodo_pago: document.getElementById('bolReMetodoPago').value,
      agencia_embarque_id: document.getElementById('bolReAgenciaOrigen').value || null,
      agencia_llegada_id:  document.getElementById('bolReAgenciaDestino').value || null,
      ruc:          document.getElementById('bolReRuc').value.trim(),
      razon_social: document.getElementById('bolReRazonSocial').value.trim()
    };
    if (body.ruc && !body.razon_social) { toast('Ingresa la razón social para la factura.', 'error'); return; }
    if (tipo === 2) {
      var numDoc = document.getElementById('bolReNumDoc').value.trim();
      var nombre = document.getElementById('bolReNombre').value.trim();
      if (!numDoc || !nombre) { toast('Ingresa el nuevo nombre completo y número de documento.', 'error'); return; }
      body.tipo_documento   = document.getElementById('bolReTipoDoc').value;
      body.numero_documento = numDoc;
      body.nombre_completo  = nombre;
      body.edad     = document.getElementById('bolReEdad').value || null;
      body.telefono = document.getElementById('bolReTelefono').value.trim() || null;
    }

    if (!window.confirm('¿Estás seguro de emitir este boleto de reintegro? El boleto original (' + serie + '-' + correlativo + ') quedará marcado como usado y esta acción no se puede deshacer.')) {
      return;
    }

    post('/boletaje/' + progId + '/asiento', body).then(function (r) {
      if (r.ok) {
        var num = r.serie + '-' + String(r.correlativo).padStart(8, '0');
        toast('Reintegro procesado: nuevo comprobante ' + num + '.', 'ok');
        cerrarReintegro();
        recargar().then(function () {
          imprimirComprobante(r.serie, r.correlativo, body.precio);
        });
      } else toast('Error: ' + (r.error || ''), 'error');
    });
  }

  return {
    abrirCroquis, cambiarTab, guardar, accion, buscarDni, buscarRuc, imprimir, cerrar,
    validarCodigo, abrirHabilitar, cerrarHabilitar, confirmarHabilitar,
    abrirReintegro, cerrarReintegro, cambiarTipoReintegro, confirmarReintegro, buscarOrigenReintegro,
    abrirEditarPrecio, cerrarEditarPrecio, guardarEditarPrecio,
    abrirTripulacion, cerrarTripulacion, guardarTripulacion, imprimirTripulacion, irAsistencia
  };
})();
</script>
